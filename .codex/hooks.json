{
  "description": "Refuse to read a skill only Yan starts; see .claude/owner-only-skills.sh",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'exec \"$(git rev-parse --show-toplevel)\"/.claude/owner-only-skills.sh'",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
