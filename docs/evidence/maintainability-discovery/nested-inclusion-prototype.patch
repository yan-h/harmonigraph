+#[test]
+fn the_loaded_state_guard_poisons_every_dialled_view_float() {
+    let opened = fresh();
+    let mut saved = fresh();
+    poison(&mut saved, Edge::High);
+    let old = &opened.picture.appearance;
+    let new = &saved.picture.appearance;
+    let mut dialled = 0;
+    macro_rules! check {
+        ($label:expr, $old:expr, $new:expr) => {{
+            let before = ron::to_string($old).expect("settings serialize");
+            let after = ron::to_string($new).expect("settings serialize");
+            dialled += assert_poisoned_float_fields($label, &before, &after);
+        }};
+    }
+    // ViewConfig mixes bars, choices and nested owners. Its direct float fields
+    // retain the existing check; the all-bar nested owners are checked through
+    // their own serialized shapes, so adding a field to one cannot pass merely
+    // because the parent sees only `(…)`.
+    check!("view", &old.view, &new.view);
+    check!("view.note_animation", &old.view.note_animation, &new.view.note_animation);
+    check!("view.glow_curve", &old.view.glow_curve, &new.view.glow_curve);
+    check!("view.atmosphere", &old.view.atmosphere, &new.view.atmosphere);
+    check!("spectrum.atmosphere", &old.spectrum.atmosphere, &new.spectrum.atmosphere);
+    for (index, (before, after)) in
+        old.view.shadow.groups().into_iter().zip(new.view.shadow.groups()).enumerate()
+    {
+        check!(&format!("view.shadow[{index}]"), &before, &after);
+    }
     // What counts as a dialled float is read off the spelling, so a change in
     // RON's would otherwise leave this passing over nothing at all.
-    assert!(dialled > 30, "only {dialled} of the view's fields read as dialled floats");
-}
+    assert!(dialled > 70, "only {dialled} fields read as dialled floats");
+}
