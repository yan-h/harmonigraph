+#[test]
+#[ignore]
+fn audit_whole_song_coverage_and_timing() {
+    // A 10 ms tone burst entirely between the windows sampled by a long
+    // whole-song hop. Remaining audio is silence; no synthetic columns.
+    let samples: Vec<f32> = (0..96000)
+        .map(|i| {
+            let t = i as f32 / 48000.0;
+            if (0.320..0.330).contains(&t) {
+                (t * 1000.0 * std::f32::consts::TAU).sin()
+            } else {
+                0.0
+            }
+        })
+        .collect();
+    for span in [12.0, 180.0, 600.0, 1800.0] {
+        let (ws, ms, a, b) = measured(|| {
+            crate::WholeSong::precompute(
+                &samples,
+                1,
+                48000.0,
+                0.0,
+                0.0,
+                span,
+                &SpectrumConfig::default(),
+            )
+        });
+        let peak = ws.columns.iter().flat_map(|c| c.db.iter()).copied().max().unwrap_or(0);
+        println!("whole_span={span} columns={} peak_byte={peak} cpu_ms={ms:.6} allocs={a} requested_bytes={b}",ws.columns.len());
+    }
+    for fps in [30, 60, 120] {
+        let mut s = crate::AudioSpectrum::default();
+        let step = 1.0 / fps as f64;
+        let chunk = vec![0.1; 48000 / fps];
+        for i in 0..fps {
+            s.push_samples(&chunk, 1, 48000.0, i as f64 * step, &SpectrumConfig::default());
+        }
+        let last = s.history.back().unwrap().time;
+        let expected = (s.frames_seen - 1) as f64 / 48000.0 - s.column_lag();
+        println!("offline_chunk_convention fps={fps} last_center={last:.9} sample_grid_center={expected:.9} offset_ms={:.6}",(last-expected)*1000.0);
+    }
+}
