+}
+pub(super) struct Targets {
+    size: [u32; 2],
+    scratch: [wgpu::TextureView; 2],
+    uniforms: [wgpu::Buffer; STAR_SLICES],
+    groups: [[wgpu::BindGroup; 2]; STAR_SLICES],
+    shapes: Option<([f32; 26], [Shape; STAR_SLICES])>,
+    counts: [u32; STAR_SLICES],
+}
+impl Targets {
+    pub fn new(
+        device: &wgpu::Device,
+        pipelines: &Pipelines,
+        size: [u32; 2],
+        atlas: &wgpu::TextureView,
+    ) -> Self {
+        let scratch = std::array::from_fn(|_| {
+            device
+                .create_texture(&wgpu::TextureDescriptor {
+                    label: Some("star_blur_scratch"),
+                    size: wgpu::Extent3d {
+                        width: size[0] + 2 * PAD,
+                        height: size[1] + 2 * PAD,
+                        depth_or_array_layers: 1,
+                    },
+                    mip_level_count: 1,
+                    sample_count: 1,
+                    dimension: wgpu::TextureDimension::D2,
+                    format: STAR_FAR_FORMAT,
+                    usage: wgpu::TextureUsages::RENDER_ATTACHMENT
+                        | wgpu::TextureUsages::TEXTURE_BINDING,
+                    view_formats: &[],
+                })
+                .create_view(&Default::default())
+        });
+        let uniforms = std::array::from_fn(|_| {
+            device.create_buffer(&wgpu::BufferDescriptor {
+                label: Some("star_blur_uniform"),
+                size: std::mem::size_of::<Uniforms>() as u64,
+                usage: wgpu::BufferUsages::UNIFORM | wgpu::BufferUsages::COPY_DST,
+                mapped_at_creation: false,
+            })
+        });
+        let groups = std::array::from_fn(|k| {
+            std::array::from_fn(|i| {
+                device.create_bind_group(&wgpu::BindGroupDescriptor {
+                    label: Some("star_blur_group"),
+                    layout: &pipelines.layout,
+                    entries: &[
+                        wgpu::BindGroupEntry {
+                            binding: 0,
+                            resource: wgpu::BindingResource::TextureView(atlas),
+                        },
+                        wgpu::BindGroupEntry {
+                            binding: 1,
+                            resource: uniforms[k].as_entire_binding(),
+                        },
+                        wgpu::BindGroupEntry {
+                            binding: 2,
+                            resource: wgpu::BindingResource::TextureView(&scratch[i]),
+                        },
+                        wgpu::BindGroupEntry {
+                            binding: 3,
+                            resource: wgpu::BindingResource::Sampler(&pipelines.sampler),
+                        },
+                    ],
+                })
+            })
+        });
+        Self { size, scratch, uniforms, groups, shapes: None, counts: [0; STAR_SLICES] }
+    }
+    pub fn update(&mut self, queue: &wgpu::Queue, slices: &[StarSlice; STAR_SLICES], jitter: f32) {
+        // Only response geometry changes the kernel. Drift, life and color must
+        // update the seeds without repeating the quadrature or reallocating.
+        let mut key = [0.0; 26];
+        key[0] = jitter;
+        for (k, s) in slices.iter().enumerate() {
+            key[1 + 5 * k..6 + 5 * k]
+                .copy_from_slice(&[s.cell, s.sigma, s.cap, s.defocus, s.fringe]);
+        }
+        if self.shapes.as_ref().is_none_or(|(old, _)| old != &key) {
+            self.shapes =
+                Some((key, std::array::from_fn(|k| shape(&slices[k], jitter, self.size))));
+        }
+        let shapes = &self.shapes.as_ref().unwrap().1;
+        for (k, s) in slices.iter().enumerate() {
+            let p = shapes[k];
+            let offset = std::array::from_fn(|i| {
+                (s.origin.0[i] + s.offset.0[i].floor() as i32) as f32 + s.offset.0[i].fract()
+            });
+            let u = Uniforms {
+                output_size: Float2(self.size.map(|n| n as f32)),
+                logical_size: Float2(p.logical.map(|n| n as f32)),
+                texture_size: Float2(self.size.map(|n| (n + 2 * PAD) as f32)),
+                cell: Float2(p.cell),
+                offset: Float2(offset),
+                grid: s.grid,
+                base: s.base,
+                mass: p.mass,
+                padding: Float2([PAD as f32; 2]),
+                weights: p.weights,
+            };
+            queue.write_buffer(&self.uniforms[k], 0, bytemuck::bytes_of(&u));
+            self.counts[k] = (s.grid.0[0] * s.grid.0[1]) as u32;
+        }
+    }
+    pub fn draw(
+        &self,
+        encoder: &mut wgpu::CommandEncoder,
+        pipelines: &Pipelines,
+        layers: &[wgpu::TextureView; STAR_SLICES],
+    ) {
+        let shapes = &self.shapes.as_ref().expect("updated before drawing").1;
+        for (k, layer) in layers.iter().enumerate() {
+            for (step, (pipeline, target, input)) in [
+                (&pipelines.seed, &self.scratch[0], 1),
+                (&pipelines.horizontal, &self.scratch[1], 0),
+                (&pipelines.vertical, layer, 1),
+            ]
+            .into_iter()
+            .enumerate()
+            {
+                let mut pass = encoder.begin_render_pass(&wgpu::RenderPassDescriptor {
+                    label: Some("star_blur"),
+                    color_attachments: &[Some(wgpu::RenderPassColorAttachment {
+                        view: target,
+                        depth_slice: None,
+                        resolve_target: None,
+                        ops: wgpu::Operations {
+                            load: wgpu::LoadOp::Clear(wgpu::Color::TRANSPARENT),
+                            store: wgpu::StoreOp::Store,
+                        },
+                    })],
+                    ..Default::default()
+                });
+                if step < 2 {
+                    let extent = shapes[k].logical.map(|n| n + 2 * PAD);
+                    pass.set_viewport(0.0, 0.0, extent[0] as f32, extent[1] as f32, 0.0, 1.0);
+                    pass.set_scissor_rect(0, 0, extent[0], extent[1]);
+                }
+                pass.set_pipeline(pipeline);
+                pass.set_bind_group(0, &self.groups[k][input], &[]);
+                if step == 0 {
+                    pass.draw(0..6, 0..self.counts[k]);
+                } else {
+                    pass.draw(0..3, 0..1);
+                }
+            }
+        }
+    }
+}
+
+fn smooth(a: f32, b: f32, x: f32) -> f32 {
+    let t = ((x - a) / (b - a)).clamp(0.0, 1.0);
+    t * t * (3.0 - 2.0 * t)
+}
+fn shape(s: &StarSlice, jitter: f32, size: [u32; 2]) -> Shape {
+    // Integrate the existing outer response, including its cutoff and removal
+    // of the native core. A Gaussian preserves its mass and approximates its
+    // second moment; it cannot reproduce the residual's central hollow.
+    let sigma = s.sigma.min(s.cap) * s.defocus;
+    let outer = 1.2 * s.cell;
+    let core = (0.5 - 0.3 * jitter) * s.cell;
+    let dr = outer / 128.0;
+    let mut mass = 0.0;
+    let mut moment = 0.0;
+    for i in 0..128 {
+        let r = (i as f32 + 0.5) * dr;
+        let d = r / sigma;
+        let g = (-0.5 * d * d).exp();
+        let full =
+            (g + s.fringe * (-0.4 * d).exp()).min(1.0) * (1.0 - smooth(0.7 * outer, outer, r));
+        let residual = (full - g * (1.0 - smooth(0.7 * core, core, r))).max(0.0);
+        let ring = 2.0 * std::f32::consts::PI * r * dr * residual;
+        mass += ring;
+        moment += ring * r * r * 0.5;
+    }
+    let width = (moment / mass.max(1e-20)).sqrt().min(0.35 * s.cell);
+    let pane = [540.0 * size[0] as f32 / size[1] as f32, 540.0];
+    let logical = std::array::from_fn(|a| {
+        ((pane[a] * 2.0 / width.max(1e-6)).ceil() as u32).clamp(1, size[a])
+    });
+    let scale: [f32; 2] = std::array::from_fn(|a| logical[a] as f32 / pane[a]);
+    let kernels: [[f32; 7]; 2] = std::array::from_fn(|a| {
+        let sigma = ((width * scale[a]).powi(2) - 1.0 / 6.0).max(0.25).sqrt();
+        let mut w = std::array::from_fn(|i| (-0.5 * (i as f32 / sigma).powi(2)).exp());
+        let sum = w[0] + 2.0 * w[1..].iter().sum::<f32>();
+        w.iter_mut().for_each(|v| *v /= sum);
+        w
+    });
+    let weights = std::array::from_fn(|i| {
+        if i == 0 {
+            return Float4([0.0, kernels[0][0], 0.0, kernels[1][0]]);
+        }
+        let pair = |a: usize| {
+            let j = 2 * i - 1;
+            let w = kernels[a][j] + kernels[a][j + 1];
+            [j as f32 + kernels[a][j + 1] / w.max(1e-20), w]
+        };
+        let x = pair(0);
+        let y = pair(1);
+        Float4([x[0], x[1], y[0], y[1]])
+    });
+    Shape {
+        logical,
+        mass: mass / (sigma * sigma) * scale[0] * scale[1],
+        cell: scale.map(|v| v * s.cell),
+        weights,
+    }
+}
diff --git a/crates/harmonigraph-render/src/shaders/star_blur.wgsl b/crates/harmonigraph-render/src/shaders/star_blur.wgsl
new file mode 100644
index 00000000..3d0ee283
--- /dev/null
+++ b/crates/harmonigraph-render/src/shaders/star_blur.wgsl
@@ -0,0 +1,75 @@
+struct Uniforms {
+    output_size: vec2<f32>,
+    logical_size: vec2<f32>,
+    texture_size: vec2<f32>,
+    cell: vec2<f32>,
+    offset: vec2<f32>,
+    grid: vec2<i32>,
+    base: i32,
+    mass: f32,
+    padding: vec2<f32>,
+    weights: array<vec4<f32>, 4>,
+}
+@group(0) @binding(0) var atlas: texture_2d<u32>;
+@group(0) @binding(1) var<uniform> u: Uniforms;
+@group(0) @binding(2) var source: texture_2d<f32>;
+@group(0) @binding(3) var linear: sampler;
+struct Seed {
+    @builtin(position) position: vec4<f32>,
+    @location(0) @interpolate(flat) centre: vec2<f32>,
+    @location(1) @interpolate(flat) paint: vec4<f32>,
+}
+@vertex
+fn vs_seed(@builtin(vertex_index) vertex: u32, @builtin(instance_index) star: u32) -> Seed {
+    let index = u.base + i32(star);
+    let t = textureLoad(atlas, vec2<i32>(index & 2047, index >> 11), 0);
+    let local = vec2<f32>(vec2<i32>(i32(star) % u.grid.x, i32(star) / u.grid.x));
+    let centre = (local + u.offset + vec2<f32>(bitcast<f32>(t.x), bitcast<f32>(t.y))) * u.cell + u.logical_size * 0.5 + u.padding;
+    let corners = array<vec2<f32>, 6>(vec2(0.0,0.0), vec2(2.0,0.0), vec2(0.0,2.0), vec2(0.0,2.0), vec2(2.0,0.0), vec2(2.0,2.0));
+    let xy = floor(centre - 0.5) + corners[vertex];
+    let ndc = xy / (u.logical_size + 2.0*u.padding) * 2.0 - 1.0;
+    var out: Seed;
+    out.position = vec4(ndc.x, -ndc.y, 0.0, 1.0);
+    out.centre = centre;
+    out.paint = vec4(0.0);
+    if t.w != 0u {
+        let shape = unpack2x16float(t.w);
+        let mass = u.mass * shape.y / (shape.x * shape.x);
+        let colour = vec3<f32>(vec3<u32>(t.z >> 20u, t.z >> 10u, t.z) & vec3<u32>(1023u)) / 1023.0;
+        out.paint = vec4(colour * mass, mass);
+    }
+    return out;
+}
+@fragment
+fn fs_seed(in: Seed) -> @location(0) vec4<f32> {
+    let tent = max(vec2(1.0) - abs(in.position.xy - in.centre), vec2(0.0));
+    return in.paint * tent.x * tent.y;
+}
+@vertex
+fn vs_fullscreen(@builtin(vertex_index) index: u32) -> @builtin(position) vec4<f32> {
+    let p = array<vec2<f32>, 3>(vec2(-1.0,-1.0), vec2(3.0,-1.0), vec2(-1.0,3.0));
+    return vec4(p[index], 0.0, 1.0);
+}
+fn sample_at(p: vec2<f32>) -> vec4<f32> {
+    let bounded = clamp(p, vec2(0.5), u.logical_size + 2.0*u.padding - 0.5);
+    return textureSampleLevel(source, linear, bounded / u.texture_size, 0.0);
+}
+@fragment
+fn fs_horizontal(@builtin(position) p: vec4<f32>) -> @location(0) vec4<f32> {
+    var sum = sample_at(p.xy) * u.weights[0].y;
+    for (var i = 1u; i < 4u; i += 1u) {
+        let w = u.weights[i];
+        sum += (sample_at(p.xy + vec2(w.x,0.0)) + sample_at(p.xy - vec2(w.x,0.0))) * w.y;
+    }
+    return sum;
+}
+@fragment
+fn fs_vertical(@builtin(position) p: vec4<f32>) -> @location(0) vec4<f32> {
+    let centre = p.xy / u.output_size * u.logical_size + u.padding;
+    var sum = sample_at(centre) * u.weights[0].w;
+    for (var i = 1u; i < 4u; i += 1u) {
+        let w = u.weights[i];
+        sum += (sample_at(centre + vec2(0.0,w.z)) + sample_at(centre - vec2(0.0,w.z))) * w.w;
+    }
+    return sum;
+}
