+#[test]
+#[ignore]
+fn scratch_take_stars_frames() {
+    use std::io::Write;
+    let (device, queue) = headless_device().expect("GPU");
+    let root = "/private/tmp/stars-gather-blur";
+    let pixels: Vec<[u8; 4]> = std::fs::read(format!("{root}/palette.rgba"))
+        .unwrap()
+        .chunks_exact(4)
+        .map(|p| p.try_into().unwrap())
+        .collect();
+    let variants = "halos,blur";
+    let frames: u32 =
+        std::env::var("PROBE_VIDEO_FRAMES").ok().map(|n| n.parse().unwrap()).unwrap_or(1);
+    for name in variants.split(',') {
+        for input in ["take", "flat"] {
+            if frames > 1 && input == "flat" {
+                continue;
+            }
+            let bytes = Arc::new(std::fs::read(format!("{root}/{input}-levels.u8")).unwrap());
+            let mut cb = cloud_fixture();
+            cb.rect = egui::Rect::from_min_size(egui::Pos2::ZERO, egui::vec2(960.0, 540.0));
+            cb.grid = grid_of(bytes, 1024, 960, 0);
+            relay_quad(&mut cb, 960);
+            let span = 12.0 * (9000.0_f32 / 70.0).log2();
+            cb.read = read_of(35.0, span, 540);
+            cb.read.spectrum_min_midi = 35.0;
+            cb.read.bins_per_semitone = 1024.0 / span;
+            cb.read.level_per_midi = 0.0;
+            cb.read.level_per_step = 1.0 / 255.0;
+            cb.shades.lut = Arc::new(pixels.clone());
+            let a = cb.atmosphere.as_mut().unwrap();
+            a.region = cb.rect;
+            a.now = 3.0;
+            a.points_per_cent = 540.0 / (span * 100.0);
+            a.points_per_ms = 960.0 / 20000.0;
+            a.settings = SpectralAtmosphere {
+                cloud_style: CloudStyle::Stars,
+                cloud_depth: 1.0,
+                star_glow: if name == "blur" {
+                    harmonigraph_scene::StarGlow::Blur
+                } else {
+                    harmonigraph_scene::StarGlow::Halos
+                },
+                star_halo_resolution: 1.0 / 3.0,
+                star_jitter: std::env::var("PROBE_JITTER")
+                    .ok()
+                    .and_then(|v| v.parse().ok())
+                    .unwrap_or(1.0),
+                ..Default::default()
+            };
+            let mut resources = CallbackResources::default();
+            let mut video = if frames > 1 {
+                Some(
+                    std::process::Command::new("ffmpeg")
+                        .args([
+                            "-v",
+                            "error",
+                            "-y",
+                            "-f",
+                            "rawvideo",
+                            "-pix_fmt",
+                            "rgba",
+                            "-s",
+                            "960x540",
+                            "-r",
+                            "30",
+                            "-i",
+                            "-",
+                            "-c:v",
+                            "libx264",
+                            "-crf",
+                            "16",
+                            "-pix_fmt",
+                            "yuv420p",
+                            &format!("{root}/{name}.mp4"),
+                        ])
+                        .stdin(std::process::Stdio::piped())
+                        .spawn()
+                        .unwrap(),
+                )
+            } else {
+                None
+            };
+            for frame in 0..frames {
+                cb.pass_nr = frame as u64;
+                cb.atmosphere.as_mut().unwrap().now = 3.0 + f64::from(frame) / 30.0;
+                let bytes = frame_with(&device, &queue, &mut resources, &cb);
+                if frame == 0 {
+                    std::fs::write(format!("{root}/{name}-{input}.rgba"), &bytes).unwrap();
+                }
+                if let Some(video) = video.as_mut() {
+                    video.stdin.as_mut().unwrap().write_all(&bytes).unwrap();
+                }
+            }
+            if let Some(mut video) = video {
+                drop(video.stdin.take());
+                assert!(video.wait().unwrap().success());
+            }
+        }
+    }
+}
