+//! Alternative Stars coverage: energy-preserving point seeds, filtered one
+//! depth at a time. The two padded scratch images are shared across depths.
+use super::{wgpu, StarSlice, STAR_FAR_FORMAT, STAR_SLICES};
+use crate::uniforms::{uniform_group, Float2, Float4, Int2};
+
+const SOURCE: &str = include_str!("../../shaders/star_blur.wgsl");
+pub(super) const PAD: u32 = 8;
+uniform_group! {
+    struct Uniforms {
+        output_size: Float2,
+        logical_size: Float2,
+        texture_size: Float2,
+        cell: Float2,
+        offset: Float2,
+        grid: Int2,
+        base: i32,
+        mass: f32,
+        padding: Float2,
+        geometry: Float4,
+        weights: [Float4; 4],
+    }
+}
+
+pub(super) struct Pipelines {
+    layout: wgpu::BindGroupLayout,
+    seed: wgpu::RenderPipeline,
+    horizontal: [wgpu::RenderPipeline; 3],
+    vertical: [wgpu::RenderPipeline; 3],
+    sampler: wgpu::Sampler,
+}
+impl Pipelines {
+    pub fn new(device: &wgpu::Device) -> Self {
+        let layout = device.create_bind_group_layout(&wgpu::BindGroupLayoutDescriptor {
+            label: Some("star_blur_layout"),
+            entries: &[
+                wgpu::BindGroupLayoutEntry {
+                    binding: 0,
+                    visibility: wgpu::ShaderStages::FRAGMENT,
+                    ty: wgpu::BindingType::Texture {
+                        sample_type: wgpu::TextureSampleType::Uint,
+                        view_dimension: wgpu::TextureViewDimension::D2,
+                        multisampled: false,
+                    },
+                    count: None,
+                },
+                wgpu::BindGroupLayoutEntry {
+                    binding: 1,
+                    visibility: wgpu::ShaderStages::VERTEX_FRAGMENT,
+                    ty: wgpu::BindingType::Buffer {
+                        ty: wgpu::BufferBindingType::Uniform,
+                        has_dynamic_offset: false,
+                        min_binding_size: None,
+                    },
+                    count: None,
+                },
+                wgpu::BindGroupLayoutEntry {
+                    binding: 2,
+                    visibility: wgpu::ShaderStages::FRAGMENT,
+                    ty: wgpu::BindingType::Texture {
+                        sample_type: wgpu::TextureSampleType::Float { filterable: true },
+                        view_dimension: wgpu::TextureViewDimension::D2,
+                        multisampled: false,
+                    },
+                    count: None,
+                },
+                wgpu::BindGroupLayoutEntry {
+                    binding: 3,
+                    visibility: wgpu::ShaderStages::FRAGMENT,
+                    ty: wgpu::BindingType::Sampler(wgpu::SamplerBindingType::Filtering),
+                    count: None,
+                },
+            ],
+        });
+        let shader = device.create_shader_module(wgpu::ShaderModuleDescriptor {
+            label: Some("star_blur"),
+            source: wgpu::ShaderSource::Wgsl(SOURCE.into()),
+        });
+        let pipeline_layout = device.create_pipeline_layout(&wgpu::PipelineLayoutDescriptor {
+            label: Some("star_blur_pipeline_layout"),
+            bind_group_layouts: &[Some(&layout)],
+            ..Default::default()
+        });
+        let pipeline = |vertex, fragment, blend, pairs: usize| {
+            device.create_render_pipeline(&wgpu::RenderPipelineDescriptor {
+                label: Some(fragment),
+                layout: Some(&pipeline_layout),
+                vertex: wgpu::VertexState {
+                    module: &shader,
+                    entry_point: Some(vertex),
+                    compilation_options: Default::default(),
+                    buffers: &[],
+                },
+                fragment: Some(wgpu::FragmentState {
+                    module: &shader,
+                    entry_point: Some(fragment),
+                    compilation_options: wgpu::PipelineCompilationOptions {
+                        constants: &[("BLUR_PAIRS", pairs as f64)],
+                        ..Default::default()
+                    },
+                    targets: &[Some(wgpu::ColorTargetState {
+                        format: STAR_FAR_FORMAT,
+                        blend,
+                        write_mask: wgpu::ColorWrites::ALL,
+                    })],
+                }),
+                primitive: Default::default(),
+                depth_stencil: None,
+                multisample: Default::default(),
+                multiview_mask: None,
+                cache: None,
+            })
+        };
+        Self {
+            seed: pipeline("vs_fullscreen", "fs_seed", None, 1),
+            horizontal: std::array::from_fn(|i| {
+                pipeline("vs_fullscreen", "fs_horizontal", None, i + 1)
+            }),
+            vertical: std::array::from_fn(|i| {
+                pipeline("vs_fullscreen", "fs_vertical", None, i + 1)
+            }),
+            layout,
+            sampler: device.create_sampler(&wgpu::SamplerDescriptor {
+                label: Some("star_blur_sampler"),
+                mag_filter: wgpu::FilterMode::Linear,
+                min_filter: wgpu::FilterMode::Linear,
+                ..Default::default()
+            }),
+        }
+    }
+}
+
+#[derive(Clone, Copy)]
+struct Shape {
+    logical: [u32; 2],
+    mass: f32,
+    cell: [f32; 2],
+    weights: [Float4; 4],
+    pairs: [f32; 2],
+}
+pub(super) struct Targets {
+    size: [u32; 2],
+    scratch: [wgpu::TextureView; 2],
+    uniforms: [wgpu::Buffer; STAR_SLICES],
+    groups: [[wgpu::BindGroup; 2]; STAR_SLICES],
+    shapes: Option<([f32; 28], [Shape; STAR_SLICES])>,
+}
+impl Targets {
+    pub fn new(
+        device: &wgpu::Device,
+        pipelines: &Pipelines,
+        size: [u32; 2],
+        atlas: &wgpu::TextureView,
+    ) -> Self {
+        let scratch = std::array::from_fn(|_| {
+            device
+                .create_texture(&wgpu::TextureDescriptor {
+                    label: Some("star_blur_scratch"),
+                    size: wgpu::Extent3d {
+                        width: size[0] + 2 * PAD,
+                        height: size[1] + 2 * PAD,
+                        depth_or_array_layers: 1,
+                    },
+                    mip_level_count: 1,
+                    sample_count: 1,
+                    dimension: wgpu::TextureDimension::D2,
+                    format: STAR_FAR_FORMAT,
+                    usage: wgpu::TextureUsages::RENDER_ATTACHMENT
+                        | wgpu::TextureUsages::TEXTURE_BINDING,
+                    view_formats: &[],
+                })
+                .create_view(&Default::default())
+        });
+        let uniforms = std::array::from_fn(|_| {
+            device.create_buffer(&wgpu::BufferDescriptor {
+                label: Some("star_blur_uniform"),
+                size: std::mem::size_of::<Uniforms>() as u64,
+                usage: wgpu::BufferUsages::UNIFORM | wgpu::BufferUsages::COPY_DST,
+                mapped_at_creation: false,
+            })
+        });
+        let groups = std::array::from_fn(|k| {
+            std::array::from_fn(|i| {
+                device.create_bind_group(&wgpu::BindGroupDescriptor {
+                    label: Some("star_blur_group"),
+                    layout: &pipelines.layout,
+                    entries: &[
+                        wgpu::BindGroupEntry {
+                            binding: 0,
+                            resource: wgpu::BindingResource::TextureView(atlas),
+                        },
+                        wgpu::BindGroupEntry {
+                            binding: 1,
+                            resource: uniforms[k].as_entire_binding(),
+                        },
+                        wgpu::BindGroupEntry {
+                            binding: 2,
+                            resource: wgpu::BindingResource::TextureView(&scratch[i]),
+                        },
+                        wgpu::BindGroupEntry {
+                            binding: 3,
+                            resource: wgpu::BindingResource::Sampler(&pipelines.sampler),
+                        },
+                    ],
+                })
+            })
+        });
+        Self { size, scratch, uniforms, groups, shapes: None }
+    }
+    pub fn update(
+        &mut self,
+        queue: &wgpu::Queue,
+        slices: &[StarSlice; STAR_SLICES],
+        jitter: f32,
+        pane: [f32; 2],
+    ) {
+        // Only response geometry changes the kernel. Drift, life and color must
+        // update the seeds without repeating the quadrature or reallocating.
+        let mut key = [0.0; 28];
+        key[26..28].copy_from_slice(&pane);
+        key[0] = jitter;
+        for (k, s) in slices.iter().enumerate() {
+            key[1 + 5 * k..6 + 5 * k]
+                .copy_from_slice(&[s.cell, s.sigma, s.cap, s.defocus, s.fringe]);
+        }
+        if self.shapes.as_ref().is_none_or(|(old, _)| old != &key) {
+            self.shapes =
+                Some((key, std::array::from_fn(|k| shape(&slices[k], jitter, self.size, pane))));
+        }
+        let shapes = &self.shapes.as_ref().unwrap().1;
+        for (k, s) in slices.iter().enumerate() {
+            let p = shapes[k];
+            let offset = std::array::from_fn(|i| {
+                (s.origin.0[i] + s.offset.0[i].floor() as i32) as f32 + s.offset.0[i].fract()
+            });
+            let u = Uniforms {
+                output_size: Float2(self.size.map(|n| n as f32)),
+                logical_size: Float2(p.logical.map(|n| n as f32)),
+                texture_size: Float2(self.size.map(|n| (n + 2 * PAD) as f32)),
+                cell: Float2(p.cell),
+                offset: Float2(offset),
+                grid: s.grid,
+                base: s.base,
+                mass: p.mass,
+                padding: Float2([PAD as f32; 2]),
+                geometry: Float4([0.5 - 0.3 * jitter, 0.5 + 0.3 * jitter, p.pairs[0], p.pairs[1]]),
+                weights: p.weights,
+            };
+            queue.write_buffer(&self.uniforms[k], 0, bytemuck::bytes_of(&u));
+        }
+    }
+    pub fn mapping(&self) -> [Float4; STAR_SLICES] {
+        let shapes = &self.shapes.as_ref().expect("updated before mapping").1;
+        std::array::from_fn(|k| {
+            let tex = self.size.map(|n| (n + 2 * PAD) as f32);
+            Float4([
+                shapes[k].logical[0] as f32 / tex[0],
+                shapes[k].logical[1] as f32 / tex[1],
+                PAD as f32 / tex[0],
+                PAD as f32 / tex[1],
+            ])
+        })
+    }
+    pub fn draw(
+        &self,
+        encoder: &mut wgpu::CommandEncoder,
+        pipelines: &Pipelines,
+        layers: &[wgpu::TextureView; STAR_SLICES],
+    ) {
+        let shapes = &self.shapes.as_ref().expect("updated before drawing").1;
+        for (k, layer) in layers.iter().enumerate() {
+            for (pipeline, target, input) in [
+                (&pipelines.seed, &self.scratch[0], 1),
+                (&pipelines.horizontal[shapes[k].pairs[0] as usize - 1], &self.scratch[1], 0),
+                (&pipelines.vertical[shapes[k].pairs[1] as usize - 1], layer, 1),
+            ]
+            .into_iter()
+            {
+                let mut pass = encoder.begin_render_pass(&wgpu::RenderPassDescriptor {
+                    label: Some("star_blur"),
+                    color_attachments: &[Some(wgpu::RenderPassColorAttachment {
+                        view: target,
+                        depth_slice: None,
+                        resolve_target: None,
+                        ops: wgpu::Operations {
+                            load: wgpu::LoadOp::Clear(wgpu::Color::TRANSPARENT),
+                            store: wgpu::StoreOp::Store,
+                        },
+                    })],
+                    ..Default::default()
+                });
+                {
+                    let extent = shapes[k].logical.map(|n| n + 2 * PAD);
+                    pass.set_viewport(0.0, 0.0, extent[0] as f32, extent[1] as f32, 0.0, 1.0);
+                    pass.set_scissor_rect(0, 0, extent[0], extent[1]);
+                }
+                pass.set_pipeline(pipeline);
+                pass.set_bind_group(0, &self.groups[k][input], &[]);
+                pass.draw(0..3, 0..1);
+            }
+        }
+    }
+}
+
+fn smooth(a: f32, b: f32, x: f32) -> f32 {
+    let t = ((x - a) / (b - a)).clamp(0.0, 1.0);
+    t * t * (3.0 - 2.0 * t)
+}
+pub(super) fn border(s: &StarSlice, jitter: f32, size: [u32; 2], pane: [f32; 2]) -> u32 {
+    let p = shape(s, jitter, size, pane);
+    (((PAD + 1) as f32 / p.cell[0].min(p.cell[1])).ceil() as u32) + 2
+}
+fn shape(s: &StarSlice, jitter: f32, size: [u32; 2], pane: [f32; 2]) -> Shape {
+    // Integrate the existing outer response, including its cutoff and removal
+    // of the native core. A Gaussian preserves its mass and approximates its
+    // second moment; it cannot reproduce the residual's central hollow.
+    let sigma = s.sigma.min(s.cap) * s.defocus;
+    let outer = 1.2 * s.cell;
+    let core = (0.5 - 0.3 * jitter) * s.cell;
+    let dr = outer / 128.0;
+    let mut mass = 0.0;
+    let mut moment = 0.0;
+    for i in 0..128 {
+        let r = (i as f32 + 0.5) * dr;
+        let d = r / sigma;
+        let g = (-0.5 * d * d).exp();
+        let full =
+            (g + s.fringe * (-0.4 * d).exp()).min(1.0) * (1.0 - smooth(0.7 * outer, outer, r));
+        let residual = (full - g * (1.0 - smooth(0.7 * core, core, r))).max(0.0);
+        let ring = 2.0 * std::f32::consts::PI * r * dr * residual;
+        mass += ring;
+        moment += ring * r * r * 0.5;
+    }
+    let width = (moment / mass.max(1e-20)).sqrt().min(0.35 * s.cell);
+    let logical = std::array::from_fn(|a| {
+        ((pane[a] * 2.0 / width.max(1e-6)).ceil() as u32).clamp(1, size[a])
+    });
+    let scale: [f32; 2] = std::array::from_fn(|a| logical[a] as f32 / pane[a]);
+    let kernels: [[f32; 7]; 2] = std::array::from_fn(|a| {
+        let sigma = ((width * scale[a]).powi(2) - 1.0 / 6.0).max(0.25).sqrt();
+        let radius = 2 * (sigma * 1.5).ceil().clamp(1.0, 3.0) as usize;
+        let mut w = std::array::from_fn(|i| {
+            if i <= radius {
+                (-0.5 * (i as f32 / sigma).powi(2)).exp()
+            } else {
+                0.0
+            }
+        });
+        let sum = w[0] + 2.0 * w[1..].iter().sum::<f32>();
+        w.iter_mut().for_each(|v| *v /= sum);
+        w
+    });
+    let weights = std::array::from_fn(|i| {
+        if i == 0 {
+            return Float4([0.0, kernels[0][0], 0.0, kernels[1][0]]);
+        }
+        let pair = |a: usize| {
+            let j = 2 * i - 1;
+            let w = kernels[a][j] + kernels[a][j + 1];
+            [j as f32 + kernels[a][j + 1] / w.max(1e-20), w]
+        };
+        let x = pair(0);
+        let y = pair(1);
+        Float4([x[0], x[1], y[0], y[1]])
+    });
+    let pairs = std::array::from_fn(|a| {
+        if kernels[a][5] > 0.0 {
+            3.0
+        } else if kernels[a][3] > 0.0 {
+            2.0
+        } else {
+            1.0
+        }
+    });
+    Shape {
+        pairs,
+        logical,
+        mass: mass / (sigma * sigma) * scale[0] * scale[1],
+        cell: scale.map(|v| v * s.cell),
+        weights,
+    }
+}
