+    /// Scratch MRT path; update() already advanced the current history index.
+    /// Return false before encoding anything whenever the ordinary path is needed.
+    #[cfg(test)]
+    pub fn research_fused_stars(
+        &self,
+        encoder: &mut wgpu::CommandEncoder,
+        pipelines: &Pipelines,
+    ) -> bool {
+        if !super::tests::research::fused() { return false; }
+        let Some(pipeline) = &pipelines.research_fused_stars else { return false; };
+        let Some((stars, size)) = &self.stars else { return false; };
+        let Some(memory) = &self.memory else { return false; };
+        // Stars currently share this exact allocation and logical extent.
+        // A future different allocation must fall back, not draw mismatched MRTs.
+        if *size != memory.size || *size != memory.extent { return false; }
+        self.encoded_passes.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+        let attachment = |view| Some(wgpu::RenderPassColorAttachment {
+            view,
+            depth_slice: None,
+            resolve_target: None,
+            ops: wgpu::Operations {
+                load: wgpu::LoadOp::Clear(wgpu::Color::TRANSPARENT),
+                store: wgpu::StoreOp::Store,
+            },
+        });
+        // Diagnostic bake_ms spans this combined pass; memory_ms is absent.
+        // It is never an exclusive cost estimate or summed with other passes.
+        let query = super::tests::research::stage_query();
+        let mut pass = encoder.begin_render_pass(&wgpu::RenderPassDescriptor {
+            label: Some("research_fused_star_memory_bake"),
+            color_attachments: &[
+                attachment(stars),
+                attachment(&memory.views[memory.index]),
+            ],
+            timestamp_writes: super::tests::research::stage_writes(query.as_ref(), 5, 6),
+            ..Default::default()
+        });
+        pass.set_pipeline(pipeline);
+        pass.set_viewport(0.0, 0.0, size[0] as f32, size[1] as f32, 0.0, 1.0);
+        pass.set_scissor_rect(0, 0, size[0], size[1]);
+        pass.set_bind_group(0, &self.source_group, &[]);
+        // groups[index] reads history[1-index] and binds the scratch star atlas.
+        // star_groups[index] would alias the attached CURRENT history and is wrong.
+        pass.set_bind_group(1, &memory.groups[memory.index], &[]);
+        pass.draw(0..3, 0..1);
+        true
+    }
+
