+// One source of dimensions for WGSL declaration/addressing/loading and dispatch.
+// Capture this once in the pipeline object; never reread ACTIVE during draw.
+pub(in crate::spectrogram) fn compute_group(mode: u32) -> [u32; 2] {
+    ACTIVE.with_borrow(|name| {
+        let group = if name.ends_with("-g4") { [4, 4] }
+            else if name.ends_with("-g16") { [16, 8] }
+            else { [8, 8] };
+        if group != [8, 8] { assert_eq!(mode, 2, "group experiment requires raw shared"); }
+        group
+    })
+}
+
+pub(in crate::spectrogram) fn compute_group_source(mut source: String, group: [u32; 2]) -> String {
+    if group == [8, 8] { return source; } // Preserve exact source for the control.
+    assert!(group == [4, 4] || group == [16, 8]);
+    let [x, y] = group;
+    let replacements = [
+        ("@compute @workgroup_size(8, 8, 1)".to_owned(),
+         format!("@compute @workgroup_size({x}, {y}, 1)")),
+        ("let base_pixel = wid.xy * vec2<u32>(8u);".to_owned(),
+         format!("let base_pixel = wid.xy * vec2<u32>({x}u, {y}u);")),
+        ("let last_pixel = min(base_pixel + vec2<u32>(7u), size - vec2<u32>(1u));".to_owned(),
+         format!("let last_pixel = min(base_pixel + vec2<u32>({}u, {}u), size - vec2<u32>(1u));", x - 1, y - 1)),
+        ("for (var n = lane; n < count; n += 64u)".to_owned(),
+         format!("for (var n = lane; n < count; n += {}u)", x * y)),
+    ];
+    for (before, after) in replacements {
+        assert_eq!(source.matches(before.as_str()).count(), 1, "compute group anchor changed: {before}");
+        source = source.replace(before.as_str(), after.as_str());
+    }
+    source
+}
