+// A few deliberately different stress pictures, not a parameter factorial.
+// Profiles preserve each case's halo resolution/shader and override PROBE_JITTER
+// only when named; `default` retains the existing harness controls verbatim.
+fn research_profile() -> String {
+    let profile = std::env::var("PROBE_PROFILE").unwrap_or_else(|_| "default".into());
+    assert!(matches!(profile.as_str(), "default" | "small-dense" | "large-sparse"
+        | "wide-range" | "fringe-zero" | "memory-off"), "unknown PROBE_PROFILE {profile}");
+    eprintln!("research profile: {profile}");
+    profile
+}
+
+fn apply_research_profile(s: &mut SpectralAtmosphere, profile: &str) {
+    use harmonigraph_scene::atmosphere::{STAR_DENSITY_MIN, STAR_DENSITY_MAX,
+        STAR_SIZE_MIN, STAR_SIZE_MAX};
+    if profile == "default" { return; }
+    // The timing and image initializers both use defaults for these fields;
+    // assign them here so named profiles state the same complete experiment.
+    let fresh = SpectralAtmosphere::default();
+    s.star_density = fresh.star_density;
+    s.star_size_min = fresh.star_size_min;
+    s.star_size_max = fresh.star_size_max;
+    s.star_fringe = fresh.star_fringe;
+    s.star_jitter = 1.0;
+    s.color_pickup = fresh.color_pickup;
+    s.color_release = fresh.color_release;
+    match profile {
+        "small-dense" => {
+            s.star_size_min = STAR_SIZE_MIN;
+            s.star_size_max = 2.0;
+            s.star_density = STAR_DENSITY_MAX;
+        }
+        "large-sparse" => {
+            s.star_size_min = 16.0;
+            s.star_size_max = STAR_SIZE_MAX;
+            s.star_density = STAR_DENSITY_MIN;
+            s.star_jitter = 0.5;
+        }
+        "wide-range" => {
+            s.star_size_min = STAR_SIZE_MIN;
+            s.star_size_max = STAR_SIZE_MAX;
+            s.star_density = STAR_DENSITY_MAX;
+            s.star_jitter = 0.5;
+        }
+        "fringe-zero" => s.star_fringe = 0.0,
+        "memory-off" => {
+            s.star_jitter = 0.5;
+            s.color_pickup = 0.0;
+            s.color_release = 0.0;
+        }
+        _ => unreachable!("validated by research_profile"),
+    }
+}
