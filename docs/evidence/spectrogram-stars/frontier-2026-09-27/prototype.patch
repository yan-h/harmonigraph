+                let bytes = scratch_frame_at_ppp(&device, &queue, &mut resources, &cb, ppp);
+                if input == "take" && std::env::var_os("RESEARCH_ATLAS_DUMP").is_some() {
+                    let target = resources.get::<SpectrogramResources>().unwrap()
+                        .panes.get(0).unwrap().cloud.as_ref().unwrap();
+                    target.research_export_atlas(&device, &queue,
+                        &format!("{out}/{name}-{input}-atlas-{frame:04}"));
+                }
+
+                if frame == 0 {
+                    std::fs::write(format!("{out}/{name}-{input}.rgba"), &bytes).unwrap();
+                }
+                if let Some(video) = video.as_mut() {
+                    video.stdin.as_mut().unwrap().write_all(&bytes).unwrap();
+                }
+            }
+            if let Some(mut video) = video {
+                drop(video.stdin.take());
+                assert!(video.wait().unwrap().success());
+            }
+        }
+    }
+}
+
+fn scratch_frame_at_ppp(
+    device: &wgpu::Device,
+    queue: &wgpu::Queue,
+    resources: &mut CallbackResources,
+    cb: &SpectrogramCallback,
+    ppp: f32,
+) -> Vec<u8> {
+    let size = [(cb.rect.max.x * ppp).ceil() as u32, (cb.rect.max.y * ppp).ceil() as u32];
+    let screen = ScreenDescriptor { size_in_pixels: size, pixels_per_point: ppp };
+    let mut encoder = device.create_command_encoder(&Default::default());
+    let bufs = cb.prepare(device, queue, &screen, &mut encoder, resources);
+    queue.submit(bufs.into_iter().chain([encoder.finish()]));
+    let texture =
+        render_to_texture(device, queue, size, cb.target_format, wgpu::Color::BLACK, |pass| {
+            cb.paint(
+                egui::PaintCallbackInfo {
+                    viewport: cb.rect,
+                    clip_rect: cb.rect,
+                    pixels_per_point: ppp,
+                    screen_size_px: size,
+                },
+                pass,
+                resources,
+            );
+        });
+    readback(device, queue, &texture, size)
+}
+
+fn factors(name: &str) -> [f32; 5] {
+    let mut f = [1.0; 5];
+    if let Some(tail) = name.strip_prefix("full-l") {
+        let k = tail[0..1].parse::<usize>().unwrap();
+        f[k] = if let Some(percent) = tail[1..].strip_prefix("r") { percent.parse::<f32>().unwrap() / 100.0 } else if tail.ends_with("third") { 1.0 / 3.0 } else { 0.5 };
+    }
+    if let Some((_, values)) = name.split_once("-v") {
+        let values = values.split('_').map(|v| v.parse::<f32>().unwrap() / 100.0).collect::<Vec<_>>();
+        f = values.try_into().expect("five layer resolutions");
+        assert!(f.iter().all(|r| (0.25..=1.0).contains(r)));
+    }
+    if name == "half-low2" { f = [0.5,0.5,1.0,1.0,1.0]; }
+    if name == "half-low3" { f = [0.5,0.5,0.5,1.0,1.0]; }
+    if name.ends_with("mix1") {
+        f = [1.0, 1.0, 1.0, 0.5, 0.5];
+    }
+    if name.ends_with("mix2") {
+        f = [1.0, 1.0, 0.5, 0.5, 0.5];
+    }
+    if name.ends_with("mix3") {
+        f = [1.0, 1.0, 1.0, 1.0, 0.5];
+    }
+    if name.ends_with("mix4") {
+        f = [0.5, 0.5, 0.5, 1.0, 1.0];
+    }
+    if name.ends_with("mix5") {
+        f = [0.5, 0.5, 1.0, 1.0, 1.0];
+    }
+    if name.ends_with("mix6") {
+        f = [0.5, 0.5, 0.75, 1.0, 0.75];
+    }
+    if name.ends_with("mix7") {
+        f = [0.5, 0.5, 0.5, 1.0, 0.5];
+    }
+    f
+}
+pub(in crate::spectrogram) fn halo_extent(size: [u32; 2], layer: usize) -> [u32; 2] {
+    let factor = ACTIVE.with_borrow(|n| factors(n)[layer]);
+    size.map(|n| (n as f32 * factor).ceil().max(1.0) as u32)
+}
+
+
+// One source of dimensions for WGSL declaration/addressing/loading and dispatch.
+// Capture this once in the pipeline object; never reread ACTIVE during draw.
+pub(in crate::spectrogram) fn compute_group(mode: u32) -> [u32; 2] {
+    ACTIVE.with_borrow(|name| {
+        let group = if name.ends_with("-g4") { [4, 4] }
+            else if name.ends_with("-g16") { [16, 8] }
+            else { [8, 8] };
+        if group != [8, 8] { assert_eq!(mode, 2, "group experiment requires raw shared"); }
+        group
+    })
+}
+
+pub(in crate::spectrogram) fn compute_group_source(mut source: String, group: [u32; 2]) -> String {
+    if group == [8, 8] { return source; } // Preserve exact source for the control.
+    assert!(group == [4, 4] || group == [16, 8]);
+    let [x, y] = group;
+    let replacements = [
+        ("@compute @workgroup_size(8, 8, 1)".to_owned(),
+         format!("@compute @workgroup_size({x}, {y}, 1)")),
+        ("let base_pixel = wid.xy * vec2<u32>(8u);".to_owned(),
+         format!("let base_pixel = wid.xy * vec2<u32>({x}u, {y}u);")),
+        ("let last_pixel = min(base_pixel + vec2<u32>(7u), size - vec2<u32>(1u));".to_owned(),
+         format!("let last_pixel = min(base_pixel + vec2<u32>({}u, {}u), size - vec2<u32>(1u));", x - 1, y - 1)),
+        ("for (var n = lane; n < count; n += 64u)".to_owned(),
+         format!("for (var n = lane; n < count; n += {}u)", x * y)),
+    ];
+    for (before, after) in replacements {
+        assert_eq!(source.matches(before.as_str()).count(), 1, "compute group anchor changed: {before}");
+        source = source.replace(before.as_str(), after.as_str());
+    }
+    source
+}
+
+pub(in crate::spectrogram) fn compute_mode() -> u32 {
+    ACTIVE.with_borrow(|s| {
+        if s.contains("compute-gather") {
+            1
+        } else if s.contains("compute-raw") {
+            2
+        } else if s.contains("compute-decoded") {
+            3
+        } else {
+            0
+        }
+    })
+}
