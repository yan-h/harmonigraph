+//! Temporary ignored capture of production rendering, using the frozen research fixture.
+//! No source substitutions, render-path overrides, or experimental resource hooks.
+use super::*;
+use harmonigraph_scene::{CloudStyle, MaterialSettings, SpectralAtmosphere, StarHaloProfile};
+
+// Pin the defaults compiled into frozen-research/research-render (base fd7c8f9),
+// rather than letting unrelated future appearance defaults move the reference.
+fn captured_settings(profile: StarHaloProfile, resolution: f32) -> SpectralAtmosphere {
+    SpectralAtmosphere {
+        pitch_softness: 6.726_529_6,
+        time_softness: 0.0,
+        spread: 0.0,
+        blur_time_step: 1.0,
+        contour_strength: 1.0,
+        contours: 17.0,
+        contour_softness: 0.492_202_6,
+        cloud_depth: 1.0,
+        color_pickup: 0.043_984_346,
+        color_release: 0.711_714_74,
+        cloud_speed: 4.242_738_7,
+        cloud_direction: 174.0,
+        cloud_style: CloudStyle::Stars,
+        material_settings: MaterialSettings::default(), // Inert in Stars.
+        star_density: 10.0,
+        star_randomness: 0.080912866,
+        star_jitter: 0.5,
+        star_size_min: 2.315533,
+        star_size_max: 14.752405,
+        star_size_curve: 2.1178954,
+        star_speed_min: 0.08931082,
+        star_speed_max: 0.16860056,
+        star_speed_curve: 3.179647,
+        star_lifetime: 2.9719827,
+        star_fringe: 0.5,
+        star_halo_resolution: resolution,
+        star_halo_profile: profile,
+        star_defocus: 0.35391274,
+    }
+}
+
+#[test]
+#[ignore]
+fn stars_live_production_images() {
+    let (device, queue) = headless_device().expect("GPU required for explicit image capture");
+    let root = "/private/tmp/stars-full-halo-compare";
+    let out = std::env::var("LIVE_PARITY_OUTPUT").expect("LIVE_PARITY_OUTPUT required");
+    std::fs::create_dir_all(&out).unwrap();
+    let ppp: f32 = std::env::var("LIVE_PARITY_PPP")
+        .ok().map(|s| s.parse().unwrap()).unwrap_or(2.0);
+    assert!([2.0_f32, 4.0, 1.001].contains(&ppp), "bounded capture supports PPP2,4,1.001");
+    let size = [(960.0_f32 * ppp).ceil() as u32, (540.0_f32 * ppp).ceil() as u32];
+    let palette = std::fs::read(format!("{root}/palette.rgba")).unwrap();
+    assert_eq!(palette.len(), 4096 * 4);
+    let pixels: Vec<[u8; 4]> = palette.chunks_exact(4).map(|p| p.try_into().unwrap()).collect();
+    for (name, profile, resolution) in [
+        ("Half", StarHaloProfile::Uniform, 0.5),
+        ("Full", StarHaloProfile::Uniform, 1.0),
+        ("P2", StarHaloProfile::P2, 1.0),
+        ("P3", StarHaloProfile::P3, 1.0),
+    ] {
+        for input in ["take", "flat"] {
+            let bytes = std::fs::read(format!("{root}/{input}-levels.u8")).unwrap();
+            assert_eq!(bytes.len(), 1024 * 960);
+            let mut cb = cloud_fixture();
+            cb.rect = egui::Rect::from_min_size(egui::Pos2::ZERO, egui::vec2(960.0, 540.0));
+            cb.grid = grid_of(Arc::new(bytes), 1024, 960, 0);
+            relay_quad(&mut cb, 960);
+            let span = 12.0 * (9000.0_f32 / 70.0).log2();
+            cb.read = read_of(35.0, span, 540);
+            cb.read.spectrum_min_midi = 35.0;
+            cb.read.bins_per_semitone = 1024.0 / span;
+            cb.read.level_per_midi = 0.0;
+            cb.read.level_per_step = 1.0 / 255.0;
+            cb.shades.lut = Arc::new(pixels.clone());
+            let a = cb.atmosphere.as_mut().unwrap();
+            a.region = cb.rect;
+            a.now = 3.0;
+            a.points_per_cent = 540.0 / (span * 100.0);
+            a.points_per_ms = 960.0 / 20000.0;
+            a.settings = captured_settings(profile, resolution);
+            assert_eq!(cb.target_format, wgpu::TextureFormat::Rgba8Unorm);
+            let mut resources = CallbackResources::default();
+            for warm in 0..60 {
+                cb.pass_nr = warm;
+                cb.atmosphere.as_mut().unwrap().now = 3.0 - 2.0 + warm as f64 / 30.0;
+                let _ = capture_frame(&device, &queue, &mut resources, &cb, ppp);
+            }
+            cb.pass_nr = 60;
+            cb.atmosphere.as_mut().unwrap().now = 3.0;
+            let bytes = capture_frame(&device, &queue, &mut resources, &cb, ppp);
+            assert_eq!(bytes.len(), size[0] as usize * size[1] as usize * 4);
+            std::fs::write(format!("{out}/{name}-{input}.rgba"), bytes).unwrap();
+        }
+    }
+    // Written last: absence means a partial/failed capture, not complete evidence.
+    std::fs::write(format!("{out}/manifest.json"), format!(
+        "{{\"fixture\":\"frozen-research-default\",\"ppp\":{ppp},\"size\":[{},{}],\"cases\":[\"Half\",\"Full\",\"P2\",\"P3\"],\"inputs\":[\"take\",\"flat\"],\"frames\":1,\"warmup\":60,\"fps\":30,\"time\":3,\"jitter\":0.5,\"format\":\"Rgba8Unorm\",\"shader\":\"production\"}}\n",
+        size[0], size[1],
+    )).unwrap();
+}
+
+// Copied verbatim in behavior from the frozen research scratch_frame_at_ppp.
+fn capture_frame(
+    device: &wgpu::Device,
+    queue: &wgpu::Queue,
+    resources: &mut CallbackResources,
+    cb: &SpectrogramCallback,
+    ppp: f32,
+) -> Vec<u8> {
+    let size = [(cb.rect.max.x * ppp).ceil() as u32, (cb.rect.max.y * ppp).ceil() as u32];
+    let screen = ScreenDescriptor { size_in_pixels: size, pixels_per_point: ppp };
+    let mut encoder = device.create_command_encoder(&Default::default());
+    let bufs = cb.prepare(device, queue, &screen, &mut encoder, resources);
+    queue.submit(bufs.into_iter().chain([encoder.finish()]));
+    let texture = render_to_texture(device, queue, size, cb.target_format, wgpu::Color::BLACK, |pass| {
+        cb.paint(
+            egui::PaintCallbackInfo {
+                viewport: cb.rect,
+                clip_rect: cb.rect,
+                pixels_per_point: ppp,
+                screen_size_px: size,
+            },
+            pass,
+            resources,
+        );
+    });
+    readback(device, queue, &texture, size)
+}
