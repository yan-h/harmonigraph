+#[test]
+#[ignore = "scratch far coverage masks, sampled through actual production composition"]
+fn far_coverage_image_probe() {
+    let Some((device, queue)) = headless_device() else { panic!("GPU required") };
+    let output =
+        std::env::var("FAR_OUTPUT").unwrap_or_else(|_| "/tmp/far-coverage/flat".to_owned());
+    std::fs::create_dir_all(&output).unwrap();
+    let mut cb = star_fixture([768, 432], egui::Pos2::ZERO);
+    cb.grid.fill(160);
+    cb.atmosphere.as_mut().unwrap().settings = harmonigraph_scene::SpectralAtmosphere::default();
+    for mode in 0..3 {
+        super::super::far_coverage_probe::set(mode);
+        let mut resources = CallbackResources::default();
+        for step in 0..120 {
+            cb.pass_nr = step;
+            cb.atmosphere.as_mut().unwrap().now = 1.0 + step as f64 / 24.0;
+            let bytes = frame_at_ppp(&device, &queue, &mut resources, &cb, 2.0);
+            if step >= 96 {
+                std::fs::write(format!("{output}/mode-{mode}-frame-{}.rgba", step - 96), bytes)
+                    .unwrap();
+            }
+        }
+    }
+    super::super::far_coverage_probe::set(0);
+}
