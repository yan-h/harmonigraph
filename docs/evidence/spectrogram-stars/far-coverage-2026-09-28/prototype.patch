diff --git a/crates/harmonigraph-render/src/spectrogram/far_coverage_probe.rs b/crates/harmonigraph-render/src/spectrogram/far_coverage_probe.rs
new file mode 100644
index 00000000..16a32b4e
--- /dev/null
+++ b/crates/harmonigraph-render/src/spectrogram/far_coverage_probe.rs
@@ -0,0 +1,29 @@
+// Scratch look comparison only; no persisted setting or production mode.
+use std::cell::Cell;
+thread_local! { static MODE: Cell<Option<u8>> = const { Cell::new(None) }; }
+pub(super) fn mode() -> u8 {
+    MODE.get().unwrap_or_else(|| {
+        std::env::var("HG_FAR_PROBE").ok().and_then(|s| s.parse().ok()).unwrap_or(0)
+    })
+}
+#[cfg(test)]
+pub(super) fn set(mode: u8) {
+    MODE.set(Some(mode));
+}
+pub(super) fn shader(source: std::borrow::Cow<'static, str>) -> std::borrow::Cow<'static, str> {
+    let mut source = source.into_owned();
+    if mode() == 2 {
+        source = source
+            .replace("const FAR_EXTRA: bool = false;", "const FAR_EXTRA: bool = true;")
+            .replace("const ACTIVE_STAR_SLICES: u32 = 5u;", "const ACTIVE_STAR_SLICES: u32 = 7u;")
+            .replace("const STAR_FAR_LAYERS: u32 = 3u;", "const STAR_FAR_LAYERS: u32 = 5u;");
+    }
+    let diagnostic =
+        std::env::var("HG_FAR_DEBUG").ok().and_then(|s| s.parse::<u32>().ok()).unwrap_or(0);
+    source = source
+        .replace("const FAR_DEBUG: u32 = 0u;", &format!("const FAR_DEBUG: u32 = {diagnostic}u;"));
+    if std::env::var("HG_FAR_FLAT").as_deref() == Ok("1") {
+        source = source.replace("const FAR_FLAT: bool = false;", "const FAR_FLAT: bool = true;");
+    }
+    source.into()
+}
