@@ -0,0 +1,15 @@
+use std::cell::RefCell;
+thread_local! { static ACTIVE: RefCell<Option<String>> = const { RefCell::new(None) }; }
+pub(super) fn activate(name: &str) { ACTIVE.with_borrow_mut(|v| *v=Some(name.to_owned())); }
+pub(super) fn name() -> String { ACTIVE.with_borrow(|v| v.clone()).unwrap_or_else(|| std::env::var("HG_ARCH").unwrap_or_default()) }
+pub(super) fn source() -> Option<String> {
+ let n=name(); if n.is_empty() {return None;}
+ let d=std::env::var("HG_ARCH_DIR").expect("HG_ARCH_DIR");
+ Some(std::fs::read_to_string(format!("{d}/{n}.wgsl")).unwrap())
+}
+pub(super) fn direct_mask() -> u32 {
+ let n=name(); if n.starts_with("direct4") {31}
+ else if let Some(m)=n.strip_prefix("hybrid-") {31 ^ m.parse::<u32>().unwrap()}
+ else if n.starts_with("group3") {7} else if n.starts_with("group5") {31} else {0}
+}
+pub(super) fn group_scale() -> Option<f32> {let n=name(); if n.starts_with("group") {Some(if n.ends_with("100") {1.0} else if n.ends_with("50") {0.5} else {0.75})} else {None}}
