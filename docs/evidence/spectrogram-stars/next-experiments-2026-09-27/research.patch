+#[cfg(test)]
+mod probe {
+    use super::*;
+    use crate::gpu_harness::{headless_device, render_to_texture};
+
+    #[test]
+    fn gathered_seeds_match_independent_tent_deposits_through_full_jitter_motion() { run_probe(false); }
+    #[test]
+    fn fused_filter_matches_independent_discrete_convolution_through_full_jitter_motion() { run_probe(true); }
+    fn run_probe(fused:bool) {
+        let (device, queue) = headless_device().expect("GPU");
+        let pipelines = Pipelines::new(&device);
+        let logical = [9u32, 11u32];
+        let extent = logical.map(|n| n + 2 * PAD);
+        let atlas = device.create_texture(&wgpu::TextureDescriptor {
+            label: Some("seed_probe_atlas"),
+            size: wgpu::Extent3d { width: 2048, height: 2, depth_or_array_layers: 1 },
+            mip_level_count: 1,
+            sample_count: 1,
+            dimension: wgpu::TextureDimension::D2,
+            format: wgpu::TextureFormat::Rgba32Uint,
+            usage: wgpu::TextureUsages::TEXTURE_BINDING | wgpu::TextureUsages::COPY_DST,
+            view_formats: &[],
+        });
+        // Dense cells require more than nine candidates per output texel.
+        // The nonzero base crosses an atlas row; bright sentinels outside the
+        // slice expose accidentally addressing an adjacent row or depth.
+        let base = 2040usize;
+        let grid = [18, 14];
+        let cell = [0.41f32, 0.67];
+        let sentinel = [0.5f32.to_bits(), 0.5f32.to_bits(), 1023 << 20, 0x3c003c00u32];
+        let mut data = vec![sentinel; 4096];
+        for y in 0..grid[1] {
+            for x in 0..grid[0] {
+                let i = base + y * grid[0] + x;
+                let q =
+                    [if x % 2 == 0 { 0.2f32 } else { 0.8 }, if y % 2 == 0 { 0.8f32 } else { 0.2 }];
+                data[i] = [q[0].to_bits(), q[1].to_bits(), 1023 << 20, 0x3c003c00];
+            }
+        }
+        queue.write_texture(
+            atlas.as_image_copy(),
+            bytemuck::cast_slice(&data),
+            wgpu::TexelCopyBufferLayout {
+                offset: 0,
+                bytes_per_row: Some(2048 * 16),
+                rows_per_image: None,
+            },
+            atlas.size(),
+        );
+        let targets =
+            Targets::new(&device, &pipelines, logical, &atlas.create_view(&Default::default()));
+        let mut kernel:[f32;7]=std::array::from_fn(|i|(-0.5*(i as f32/2.0).powi(2)).exp());
+        let norm=kernel[0]+2.0*kernel[1..].iter().sum::<f32>();kernel.iter_mut().for_each(|v|*v/=norm);
+        let weights=std::array::from_fn(|i|if i==0 {Float4([0.0,kernel[0],0.0,kernel[0]])} else {
+            let j=2*i-1;let w=kernel[j]+kernel[j+1];let x=j as f32+kernel[j+1]/w;Float4([x,w,x,w])
+        });
+        for phase in 0..17 {
+            let shift = phase as f32 / 16.0;
+            let offset = [-9.0 + shift, -7.0 - shift * 0.71];
+            let mass = 0.05f32;
+            let uniform = Uniforms {
+                output_size: Float2(logical.map(|n| n as f32)),
+                logical_size: Float2(logical.map(|n| n as f32)),
+                texture_size: Float2(extent.map(|n| n as f32)),
+                cell: Float2(cell),
+                offset: Float2(offset),
+                grid: Int2(grid.map(|n| n as i32)),
+                base: base as i32,
+                mass,
+                padding: Float2([PAD as f32; 2]),
+                geometry: Float4([0.2, 0.8, 0.0, 0.0]),
+                weights,
+            };
+            queue.write_buffer(&targets.uniforms[0], 0, bytemuck::bytes_of(&uniform));
+            let texture = render_to_texture(
+                &device,
+                &queue,
+                extent,
+                STAR_FAR_FORMAT,
+                wgpu::Color::TRANSPARENT,
+                |pass| {
+                    pass.set_pipeline(if fused {&pipelines.fused} else {&pipelines.seed});
+                    pass.set_bind_group(0, &targets.groups[0][1], &[]);
+                    pass.draw(0..3, 0..1);
+                },
+            );
+            let stride = (extent[0] * 8).div_ceil(256) * 256;
+            let buffer = device.create_buffer(&wgpu::BufferDescriptor {
+                label: Some("seed_probe_readback"),
+                size: u64::from(stride * extent[1]),
+                usage: wgpu::BufferUsages::COPY_DST | wgpu::BufferUsages::MAP_READ,
+                mapped_at_creation: false,
+            });
+            let mut encoder = device.create_command_encoder(&Default::default());
+            encoder.copy_texture_to_buffer(
+                texture.as_image_copy(),
+                wgpu::TexelCopyBufferInfo {
+                    buffer: &buffer,
+                    layout: wgpu::TexelCopyBufferLayout {
+                        offset: 0,
+                        bytes_per_row: Some(stride),
+                        rows_per_image: None,
+                    },
+                },
+                texture.size(),
+            );
+            queue.submit([encoder.finish()]);
+            let slice = buffer.slice(..);
+            slice.map_async(wgpu::MapMode::Read, |r| r.expect("map seed probe"));
+            device.poll(wgpu::PollType::wait_indefinitely()).unwrap();
+            let mapped = slice.get_mapped_range();
+            // Reference scatters every star into its four pixels, independent
+            // of the shader's inverse-coordinate gather bounds.
+            let mut expected = vec![0.0f32; (extent[0] * extent[1]) as usize];
+            for y in 0..grid[1] {
+                for x in 0..grid[0] {
+                    let t = data[base + y * grid[0] + x];
+                    let at = [x as f32, y as f32];
+                    let centre: [f32; 2] = std::array::from_fn(|a| {
+                        (at[a] + offset[a] + f32::from_bits(t[a])) * cell[a]
+                            + logical[a] as f32 * 0.5
+                            + PAD as f32
+                    });
+                    let first = centre.map(|v| (v - 0.5).floor() as i32);
+                    for dy in 0..2 {
+                        for dx in 0..2 {
+                            let xy = [first[0] + dx, first[1] + dy];
+                            assert!(
+                                xy[0] >= 0
+                                    && xy[1] >= 0
+                                    && xy[0] < extent[0] as i32
+                                    && xy[1] < extent[1] as i32,
+                                "fixture star must be wholly inside"
+                            );
+                            let w: [f32; 2] = std::array::from_fn(|a| {
+                                (1.0 - ((xy[a] as f32 + 0.5) - centre[a]).abs()).max(0.0)
+                            });
+                            expected[(xy[1] * extent[0] as i32 + xy[0]) as usize] +=
+                                mass * w[0] * w[1];
+                        }
+                    }
+                }
+            }
+            if fused {
+                let seeds=expected.clone();
+                for y in 0..extent[1] {for x in 0..extent[0] {
+                    expected[(y*extent[0]+x) as usize]=(-6i32..=6).map(|dx| {
+                        let sx=(x as i32+dx).clamp(0,extent[0] as i32-1) as u32;
+                        seeds[(y*extent[0]+sx) as usize]*kernel[dx.unsigned_abs() as usize]
+                    }).sum();
+                }}
+            }
+            let mut total = 0.0;
+            for y in 0..extent[1] {
+                for x in 0..extent[0] {
+                    let at = (y * stride + x * 8 + 6) as usize;
+                    let bits = u16::from_le_bytes([mapped[at], mapped[at + 1]]);
+                    let exponent = (bits >> 10) & 31;
+                    let mantissa = bits & 1023;
+                    let actual = if exponent == 0 {
+                        f32::from(mantissa) * 2.0f32.powi(-24)
+                    } else {
+                        f32::from(1024 + mantissa) * 2.0f32.powi(i32::from(exponent) - 25)
+                    };
+                    let want = expected[(y * extent[0] + x) as usize];
+                    assert!(
+                        (actual - want).abs() < 0.0003,
+                        "phase {phase}, ({x},{y}): {actual} != {want}"
+                    );
+                    total += actual;
+                }
+            }
+            let wanted_total = mass * (grid[0] * grid[1]) as f32;
+            assert!(
+                (total - wanted_total).abs() < 0.01,
+                "phase {phase}: mass {total} != {wanted_total}"
+            );
+        }
+    }
+}
