+fn smooth(a: f32, b: f32, x: f32) -> f32 {
+    let t = ((x - a) / (b - a)).clamp(0.0, 1.0);
+    t * t * (3.0 - 2.0 * t)
+}
+pub(super) fn border(s: &StarSlice, jitter: f32, size: [u32; 2], pane: [f32; 2]) -> u32 {
+    let p = shape(s, jitter, size, pane);
+    (((PAD + 1) as f32 / p.cell[0].min(p.cell[1])).ceil() as u32) + 2
+}
+fn shape(s: &StarSlice, jitter: f32, size: [u32; 2], pane: [f32; 2]) -> Shape {
+    // Integrate the existing outer response, including its cutoff and removal
+    // of the native core. A Gaussian preserves its mass and approximates its
+    // second moment; it cannot reproduce the residual's central hollow.
+    let sigma = s.sigma.min(s.cap) * s.defocus;
+    let outer = 1.2 * s.cell;
+    let core = (0.5 - 0.3 * jitter) * s.cell;
+    let dr = outer / 128.0;
+    let mut mass = 0.0;
+    let mut moment = 0.0;
+    for i in 0..128 {
+        let r = (i as f32 + 0.5) * dr;
+        let d = r / sigma;
+        let g = (-0.5 * d * d).exp();
+        let full =
+            (g + s.fringe * (-0.4 * d).exp()).min(1.0) * (1.0 - smooth(0.7 * outer, outer, r));
+        let residual = (full - g * (1.0 - smooth(0.7 * core, core, r))).max(0.0);
+        let ring = 2.0 * std::f32::consts::PI * r * dr * residual;
+        mass += ring;
+        moment += ring * r * r * 0.5;
+    }
+    let width = (moment / mass.max(1e-20)).sqrt().min(0.35 * s.cell);
+    let logical = std::array::from_fn(|a| {
+        ((pane[a] * 2.0 / width.max(1e-6)).ceil() as u32).clamp(1, size[a])
+    });
+    let scale: [f32; 2] = std::array::from_fn(|a| logical[a] as f32 / pane[a]);
+    let kernels: [[f32; 7]; 2] = std::array::from_fn(|a| {
+        let sigma = ((width * scale[a]).powi(2) - 1.0 / 6.0).max(0.25).sqrt();
+        let mut w = std::array::from_fn(|i| (-0.5 * (i as f32 / sigma).powi(2)).exp());
+        let sum = w[0] + 2.0 * w[1..].iter().sum::<f32>();
+        w.iter_mut().for_each(|v| *v /= sum);
+        w
+    });
+    let weights = std::array::from_fn(|i| {
+        if i == 0 {
+            return Float4([0.0, kernels[0][0], 0.0, kernels[1][0]]);
+        }
+        let pair = |a: usize| {
+            let j = 2 * i - 1;
+            let w = kernels[a][j] + kernels[a][j + 1];
+            [j as f32 + kernels[a][j + 1] / w.max(1e-20), w]
+        };
+        let x = pair(0);
+        let y = pair(1);
+        Float4([x[0], x[1], y[0], y[1]])
+    });
+    Shape {
+        logical,
+        mass: mass / (sigma * sigma) * scale[0] * scale[1],
+        cell: scale.map(|v| v * s.cell),
+        weights,
+    }
+}
