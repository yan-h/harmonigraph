+struct Uniforms {
+    output_size: vec2<f32>,
+    logical_size: vec2<f32>,
+    texture_size: vec2<f32>,
+    cell: vec2<f32>,
+    offset: vec2<f32>,
+    grid: vec2<i32>,
+    base: i32,
+    mass: f32,
+    padding: vec2<f32>,
+    geometry: vec4<f32>,
+    weights: array<vec4<f32>, 4>,
+}
+@group(0) @binding(0) var atlas: texture_2d<u32>;
+@group(0) @binding(1) var<uniform> u: Uniforms;
+@group(0) @binding(2) var source: texture_2d<f32>;
+@group(0) @binding(3) var linear: sampler;
+// Gather the complete tent footprint, including jitter, into one output texel.
+// Bounds grow when a texel covers multiple cells; never clamp to 3x3.
+fn gather_seed(p: vec4<f32>) -> vec4<f32> {
+    let r = (p.xy - u.padding - u.logical_size * 0.5) / u.cell - u.offset;
+    let low = max(vec2<i32>(ceil(r - 1.0 / u.cell - u.geometry.y)), vec2<i32>(0));
+    let high = min(vec2<i32>(floor(r + 1.0 / u.cell - u.geometry.x)), u.grid - 1);
+    var sum = vec4<f32>(0.0);
+    for (var y = low.y; y <= high.y; y += 1) {
+        for (var x = low.x; x <= high.x; x += 1) {
+            let index = u.base + y * u.grid.x + x;
+            let t = textureLoad(atlas, vec2<i32>(index & 2047, index >> 11), 0);
+            if t.w == 0u { continue; }
+            let centre = (vec2<f32>(f32(x), f32(y)) + u.offset + vec2<f32>(bitcast<f32>(t.x), bitcast<f32>(t.y))) * u.cell + u.logical_size * 0.5 + u.padding;
+            let tent = max(vec2(1.0) - abs(p.xy - centre), vec2(0.0));
+            let shape = unpack2x16float(t.w);
+            let mass = u.mass * shape.y / (shape.x * shape.x) * tent.x * tent.y;
+            let colour = vec3<f32>(vec3<u32>(t.z >> 20u, t.z >> 10u, t.z) & vec3<u32>(1023u)) / 1023.0;
+            sum += vec4(colour * mass, mass);
+        }
+    }
+    return sum;
+}
+@vertex
+fn vs_fullscreen(@builtin(vertex_index) index: u32) -> @builtin(position) vec4<f32> {
+    let p = array<vec2<f32>, 3>(vec2(-1.0,-1.0), vec2(3.0,-1.0), vec2(-1.0,3.0));
+    return vec4(p[index], 0.0, 1.0);
+}
+fn sample_at(p: vec2<f32>) -> vec4<f32> {
+    let bounded = clamp(p, vec2(0.5), u.logical_size + 2.0*u.padding - 0.5);
+    return textureSampleLevel(source, linear, bounded / u.texture_size, 0.0);
+}
+@fragment
+fn fs_horizontal(@builtin(position) p: vec4<f32>) -> @location(0) vec4<f32> {
+    var sum = sample_at(p.xy) * u.weights[0].y;
+    for (var i = 1u; i < 4u; i += 1u) {
+        let w = u.weights[i];
+        sum += (sample_at(p.xy + vec2(w.x,0.0)) + sample_at(p.xy - vec2(w.x,0.0))) * w.y;
+    }
+    return sum;
+}
+@fragment
+fn fs_vertical(@builtin(position) p: vec4<f32>) -> @location(0) vec4<f32> {
+    let centre = p.xy;
+    var sum = sample_at(centre) * u.weights[0].w;
+    for (var i = 1u; i < 4u; i += 1u) {
+        let w = u.weights[i];
+        sum += (sample_at(centre + vec2(0.0,w.z)) + sample_at(centre - vec2(0.0,w.z))) * w.w;
+    }
+    return sum;
+}
+
+@fragment
+fn fs_seed(@builtin(position) p: vec4<f32>) -> @location(0) vec4<f32> { return gather_seed(p); }
+fn kernel(n: i32) -> f32 {
+ let a=abs(n);
+ if a>6 {return 0.0;}
+ if a==0 {return u.weights[0].y;}
+ let pair=u32((a+1)/2); let j=f32(2u*pair-1u); let w=u.weights[pair];
+ return w.y * select(j+1.0-w.x,w.x-j,(a%2)==0);
+}
+@fragment
+fn fs_fused(@builtin(position) p: vec4<f32>) -> @location(0) vec4<f32> {
+ // Preserve real-valued boundary clamping; seed half rounding is intentionally removed.
+ if p.x < 6.5 || p.x > u.logical_size.x+2.0*u.padding.x-6.5 {
+  var edge=vec4<f32>(0.0);
+  for(var i=-6;i<=6;i+=1) {
+   let q=vec4<f32>(clamp(p.xy+vec2<f32>(f32(i),0.0),vec2<f32>(0.5),u.logical_size+2.0*u.padding-0.5),0.0,1.0);
+   edge+=gather_seed(q)*kernel(i);
+  }
+  return edge;
+ }
+ let r=(p.xy-u.padding-u.logical_size*0.5)/u.cell-u.offset;
+ let reach=vec2<f32>(7.0,1.0)/u.cell;
+ let low=max(vec2<i32>(ceil(r-reach-u.geometry.y)),vec2<i32>(0));
+ let high=min(vec2<i32>(floor(r+reach-u.geometry.x)),u.grid-1);
+ var sum=vec4<f32>(0.0);
+ for(var y=low.y;y<=high.y;y+=1) {
+  for(var x=low.x;x<=high.x;x+=1) {
+   let index=u.base+y*u.grid.x+x;
+   let t=textureLoad(atlas,vec2<i32>(index & 2047,index >> 11),0);
+   if t.w==0u {continue;}
+   let centre=(vec2<f32>(f32(x),f32(y))+u.offset+vec2<f32>(bitcast<f32>(t.x),bitcast<f32>(t.y)))*u.cell+u.logical_size*0.5+u.padding;
+   let d=centre.x-p.x;let n=i32(floor(d));let f=fract(d);
+   let horizontal=(1.0-f)*kernel(n)+f*kernel(n+1);
+   let vertical=max(1.0-abs(p.y-centre.y),0.0);
+   let shape=unpack2x16float(t.w);
+   let mass=u.mass*shape.y/(shape.x*shape.x)*horizontal*vertical;
+   let colour=vec3<f32>(vec3<u32>(t.z >> 20u,t.z >> 10u,t.z)&vec3<u32>(1023u))/1023.0;
+   sum+=vec4<f32>(colour*mass,mass);
+  }
+ }
+ return sum;
+}
