+    }
+    pub fn draw(
+        &self,
+        encoder: &mut wgpu::CommandEncoder,
+        pipelines: &Pipelines,
+        layers: &[wgpu::TextureView; STAR_SLICES],
+    ) {
+        let shapes = &self.shapes.as_ref().expect("updated before drawing").1;
+        for (k, layer) in layers.iter().enumerate() {
+            let ordinary=[(&pipelines.seed,&self.scratch[0],1),(&pipelines.horizontal,&self.scratch[1],0),(&pipelines.vertical,layer,1)];
+            let fused=[(&pipelines.fused,&self.scratch[1],0),(&pipelines.vertical,layer,1)];
+            let passes=if super::super::tests::next_timing::blur_mode()==2 { &fused[..] } else {&ordinary[..]};
+            for &(pipeline,target,input) in passes
+            {
+                let mut pass = encoder.begin_render_pass(&wgpu::RenderPassDescriptor {
+                    label: Some("star_blur"),
+                    color_attachments: &[Some(wgpu::RenderPassColorAttachment {
+                        view: target,
+                        depth_slice: None,
+                        resolve_target: None,
+                        ops: wgpu::Operations {
+                            load: wgpu::LoadOp::Clear(wgpu::Color::TRANSPARENT),
+                            store: wgpu::StoreOp::Store,
+                        },
+                    })],
+                    ..Default::default()
+                });
+                {
+                    let extent = shapes[k].logical.map(|n| n + 2 * PAD);
+                    pass.set_viewport(0.0, 0.0, extent[0] as f32, extent[1] as f32, 0.0, 1.0);
+                    pass.set_scissor_rect(0, 0, extent[0], extent[1]);
+                }
+                pass.set_pipeline(pipeline);
+                pass.set_bind_group(0, &self.groups[k][input], &[]);
+                pass.draw(0..3, 0..1);
+            }
+        }
+    }
