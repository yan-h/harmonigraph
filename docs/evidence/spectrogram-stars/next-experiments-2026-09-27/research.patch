+//! Alternative Stars coverage: energy-preserving point seeds, filtered one
+//! depth at a time. The two padded scratch images are shared across depths.
+use super::{wgpu, StarSlice, STAR_FAR_FORMAT, STAR_SLICES};
+use crate::uniforms::{uniform_group, Float2, Float4, Int2};
+
+const SOURCE: &str = include_str!("../../shaders/star_blur.wgsl");
+pub(super) const PAD: u32 = 8;
+uniform_group! {
+    struct Uniforms {
+        output_size: Float2,
+        logical_size: Float2,
+        texture_size: Float2,
+        cell: Float2,
+        offset: Float2,
+        grid: Int2,
+        base: i32,
+        mass: f32,
+        padding: Float2,
+        geometry: Float4,
+        weights: [Float4; 4],
+    }
+}
+
+pub(super) struct Pipelines {
+    layout: wgpu::BindGroupLayout,
+    seed: wgpu::RenderPipeline,
+    fused: wgpu::RenderPipeline,
+    horizontal: wgpu::RenderPipeline,
+    vertical: wgpu::RenderPipeline,
+    sampler: wgpu::Sampler,
+}
+impl Pipelines {
+    pub fn new(device: &wgpu::Device) -> Self {
+        let layout = device.create_bind_group_layout(&wgpu::BindGroupLayoutDescriptor {
+            label: Some("star_blur_layout"),
+            entries: &[
+                wgpu::BindGroupLayoutEntry {
+                    binding: 0,
+                    visibility: wgpu::ShaderStages::FRAGMENT,
+                    ty: wgpu::BindingType::Texture {
+                        sample_type: wgpu::TextureSampleType::Uint,
+                        view_dimension: wgpu::TextureViewDimension::D2,
+                        multisampled: false,
+                    },
+                    count: None,
+                },
+                wgpu::BindGroupLayoutEntry {
+                    binding: 1,
+                    visibility: wgpu::ShaderStages::VERTEX_FRAGMENT,
+                    ty: wgpu::BindingType::Buffer {
+                        ty: wgpu::BufferBindingType::Uniform,
+                        has_dynamic_offset: false,
+                        min_binding_size: None,
+                    },
+                    count: None,
+                },
+                wgpu::BindGroupLayoutEntry {
+                    binding: 2,
+                    visibility: wgpu::ShaderStages::FRAGMENT,
+                    ty: wgpu::BindingType::Texture {
+                        sample_type: wgpu::TextureSampleType::Float { filterable: true },
+                        view_dimension: wgpu::TextureViewDimension::D2,
+                        multisampled: false,
+                    },
+                    count: None,
+                },
+                wgpu::BindGroupLayoutEntry {
+                    binding: 3,
+                    visibility: wgpu::ShaderStages::FRAGMENT,
+                    ty: wgpu::BindingType::Sampler(wgpu::SamplerBindingType::Filtering),
+                    count: None,
+                },
+            ],
+        });
+        let shader = device.create_shader_module(wgpu::ShaderModuleDescriptor {
+            label: Some("star_blur"),
+            source: wgpu::ShaderSource::Wgsl(SOURCE.into()),
+        });
+        let pipeline_layout = device.create_pipeline_layout(&wgpu::PipelineLayoutDescriptor {
+            label: Some("star_blur_pipeline_layout"),
+            bind_group_layouts: &[Some(&layout)],
+            ..Default::default()
+        });
+        let pipeline = |vertex, fragment, blend| {
+            device.create_render_pipeline(&wgpu::RenderPipelineDescriptor {
+                label: Some(fragment),
+                layout: Some(&pipeline_layout),
+                vertex: wgpu::VertexState {
+                    module: &shader,
+                    entry_point: Some(vertex),
+                    compilation_options: Default::default(),
+                    buffers: &[],
+                },
+                fragment: Some(wgpu::FragmentState {
+                    module: &shader,
+                    entry_point: Some(fragment),
+                    compilation_options: Default::default(),
+                    targets: &[Some(wgpu::ColorTargetState {
+                        format: STAR_FAR_FORMAT,
+                        blend,
+                        write_mask: wgpu::ColorWrites::ALL,
+                    })],
+                }),
+                primitive: Default::default(),
+                depth_stencil: None,
+                multisample: Default::default(),
+                multiview_mask: None,
+                cache: None,
+            })
+        };
+        Self {
+            seed: pipeline("vs_fullscreen", "fs_seed", None),
+            fused: pipeline("vs_fullscreen", "fs_fused", None),
+            horizontal: pipeline("vs_fullscreen", "fs_horizontal", None),
+            vertical: pipeline("vs_fullscreen", "fs_vertical", None),
+            layout,
+            sampler: device.create_sampler(&wgpu::SamplerDescriptor {
+                label: Some("star_blur_sampler"),
+                mag_filter: wgpu::FilterMode::Linear,
+                min_filter: wgpu::FilterMode::Linear,
+                ..Default::default()
+            }),
+        }
+    }
+}
+
+#[derive(Clone, Copy)]
+struct Shape {
+    logical: [u32; 2],
+    mass: f32,
+    cell: [f32; 2],
+    weights: [Float4; 4],
+}
+pub(super) struct Targets {
+    size: [u32; 2],
+    scratch: [wgpu::TextureView; 2],
+    uniforms: [wgpu::Buffer; STAR_SLICES],
+    groups: [[wgpu::BindGroup; 2]; STAR_SLICES],
+    shapes: Option<([f32; 28], [Shape; STAR_SLICES])>,
+}
+impl Targets {
+    pub fn new(
+        device: &wgpu::Device,
+        pipelines: &Pipelines,
+        size: [u32; 2],
+        atlas: &wgpu::TextureView,
+    ) -> Self {
+        let scratch = std::array::from_fn(|_| {
+            device
+                .create_texture(&wgpu::TextureDescriptor {
+                    label: Some("star_blur_scratch"),
+                    size: wgpu::Extent3d {
+                        width: size[0] + 2 * PAD,
+                        height: size[1] + 2 * PAD,
+                        depth_or_array_layers: 1,
+                    },
+                    mip_level_count: 1,
+                    sample_count: 1,
+                    dimension: wgpu::TextureDimension::D2,
+                    format: STAR_FAR_FORMAT,
+                    usage: wgpu::TextureUsages::RENDER_ATTACHMENT
+                        | wgpu::TextureUsages::TEXTURE_BINDING,
+                    view_formats: &[],
+                })
+                .create_view(&Default::default())
+        });
+        let uniforms = std::array::from_fn(|_| {
+            device.create_buffer(&wgpu::BufferDescriptor {
+                label: Some("star_blur_uniform"),
+                size: std::mem::size_of::<Uniforms>() as u64,
+                usage: wgpu::BufferUsages::UNIFORM | wgpu::BufferUsages::COPY_DST,
+                mapped_at_creation: false,
+            })
+        });
+        let groups = std::array::from_fn(|k| {
+            std::array::from_fn(|i| {
+                device.create_bind_group(&wgpu::BindGroupDescriptor {
+                    label: Some("star_blur_group"),
+                    layout: &pipelines.layout,
+                    entries: &[
+                        wgpu::BindGroupEntry {
+                            binding: 0,
+                            resource: wgpu::BindingResource::TextureView(atlas),
+                        },
+                        wgpu::BindGroupEntry {
+                            binding: 1,
+                            resource: uniforms[k].as_entire_binding(),
+                        },
+                        wgpu::BindGroupEntry {
+                            binding: 2,
+                            resource: wgpu::BindingResource::TextureView(&scratch[i]),
+                        },
+                        wgpu::BindGroupEntry {
+                            binding: 3,
+                            resource: wgpu::BindingResource::Sampler(&pipelines.sampler),
+                        },
+                    ],
+                })
+            })
+        });
+        Self { size, scratch, uniforms, groups, shapes: None }
+    }
+    pub fn update(
+        &mut self,
+        queue: &wgpu::Queue,
+        slices: &[StarSlice; STAR_SLICES],
+        jitter: f32,
+        pane: [f32; 2],
+    ) {
+        // Only response geometry changes the kernel. Drift, life and color must
+        // update the seeds without repeating the quadrature or reallocating.
+        let mut key = [0.0; 28];
+        key[26..28].copy_from_slice(&pane);
+        key[0] = jitter;
+        for (k, s) in slices.iter().enumerate() {
+            key[1 + 5 * k..6 + 5 * k]
+                .copy_from_slice(&[s.cell, s.sigma, s.cap, s.defocus, s.fringe]);
+        }
+        if self.shapes.as_ref().is_none_or(|(old, _)| old != &key) {
+            self.shapes =
+                Some((key, std::array::from_fn(|k| shape(&slices[k], jitter, self.size, pane))));
+        }
+        let shapes = &self.shapes.as_ref().unwrap().1;
+        for (k, s) in slices.iter().enumerate() {
+            let p = shapes[k];
+            let offset = std::array::from_fn(|i| {
+                (s.origin.0[i] + s.offset.0[i].floor() as i32) as f32 + s.offset.0[i].fract()
+            });
+            let u = Uniforms {
+                output_size: Float2(self.size.map(|n| n as f32)),
+                logical_size: Float2(p.logical.map(|n| n as f32)),
+                texture_size: Float2(self.size.map(|n| (n + 2 * PAD) as f32)),
+                cell: Float2(p.cell),
+                offset: Float2(offset),
+                grid: s.grid,
+                base: s.base,
+                mass: p.mass,
+                padding: Float2([PAD as f32; 2]),
+                geometry: Float4([0.5 - 0.3 * jitter, 0.5 + 0.3 * jitter, 0.0, 0.0]),
+                weights: p.weights,
+            };
+            queue.write_buffer(&self.uniforms[k], 0, bytemuck::bytes_of(&u));
+        }
+    }
+    pub fn logical_sizes(&self) -> [[u32;2];STAR_SLICES] { self.shapes.as_ref().unwrap().1.map(|p|p.logical) }
+    pub fn mapping(&self) -> [Float4; STAR_SLICES] {
+        let shapes = &self.shapes.as_ref().expect("updated before mapping").1;
+        std::array::from_fn(|k| {
+            let tex = self.size.map(|n| (n + 2 * PAD) as f32);
+            Float4([
+                shapes[k].logical[0] as f32 / tex[0],
+                shapes[k].logical[1] as f32 / tex[1],
+                PAD as f32 / tex[0],
+                PAD as f32 / tex[1],
+            ])
