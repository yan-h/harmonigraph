+ std::fs::write(format!("{out}/manifest.json"),format!("{{\"ppp\":{ppp},\"origin\":{offset},\"frames\":{frames},\"width\":{},\"height\":{}}}",( (960.0+offset)*ppp).ceil() as u32,((540.0+offset)*ppp).ceil() as u32)).unwrap();
+ next_timing::activate("");
+}
