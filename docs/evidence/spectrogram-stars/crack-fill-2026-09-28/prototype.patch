diff --git a/crates/harmonigraph-render/src/spectrogram/coverage_probe.rs b/crates/harmonigraph-render/src/spectrogram/coverage_probe.rs
new file mode 100644
index 00000000..60290d5c
--- /dev/null
+++ b/crates/harmonigraph-render/src/spectrogram/coverage_probe.rs
@@ -0,0 +1,74 @@
+// Scratch comparison only; modes are fixed for each resource lifetime.
+use std::cell::Cell;
+thread_local! { static MODE: Cell<Option<u8>> = const { Cell::new(None) }; }
+pub(super) fn mode() -> u8 {
+    MODE.get().unwrap_or_else(|| {
+        std::env::var("HG_FILL_MODE").ok().and_then(|s| s.parse().ok()).unwrap_or(0)
+    })
+}
+#[cfg(test)]
+pub(super) fn set(mode: u8) {
+    MODE.set(Some(mode));
+}
+pub(super) fn shader(source: std::borrow::Cow<'static, str>) -> std::borrow::Cow<'static, str> {
+    let mode = mode();
+    let debug = std::env::var("HG_FILL_DEBUG").ok().and_then(|s| s.parse::<u8>().ok()).unwrap_or(0);
+    let flat = std::env::var("HG_FILL_FLAT").as_deref() == Ok("1");
+    if mode == 0 && debug == 0 && !flat {
+        return source;
+    }
+    assert!(mode <= 2);
+    let mut source = source.into_owned();
+    let start = source.find("fn star_layers(").unwrap();
+    let end = start + source[start..].find("// Both presets share").unwrap();
+    let mut body = source[start..end].to_owned();
+    body = body.replace("var out = under;", "var out = under;\n    var gap = 1.0;");
+    body = body.replace(
+        "if slice.w > 0.0 {",
+        "gap *= 1.0 - min(slice.w, 1.0);\n        if slice.w > 0.0 {",
+    );
+    let factor = match mode {
+        0 => "1.0",
+        1 => "1.0 + gap",
+        _ => "(1.0 + gap) * (1.0 + gap * gap)",
+    };
+    let opacity = match mode {
+        0 => "1.0 - gap",
+        1 => "1.0 - gap * gap",
+        _ => "1.0 - gap * gap * gap * gap",
+    };
+    let result = if debug == 2 {
+        format!("vec3<f32>({opacity})")
+    } else {
+        format!("under + (out - under) * ({factor})")
+    };
+    body = body.replace("return out;", &format!("if cloud.star_far.z > 0.0 && first == 0u && last == STAR_FAR_LAYERS {{ return {result}; }}\n    return out;"));
+    source.replace_range(start..end, &body);
+    if debug > 0 {
+        let original = "return star_layers(pt, STAR_FAR_LAYERS, STAR_SLICES, far);";
+        assert!(source.contains(original));
+        source = source.replace(original, "return far;");
+    }
+    if flat {
+        let original = "fn star_level_at(pt: vec2<f32>) -> f32 {";
+        assert!(source.contains(original));
+        source = source.replace(original, &format!("{original}\n    if true {{ return 0.6; }}"));
+    }
+    if let Ok(directory) = std::env::var("HG_FILL_DUMP") {
+        std::fs::create_dir_all(&directory).unwrap();
+        std::fs::write(format!("{directory}/mode-{mode}-debug-{debug}-flat-{flat}.wgsl"), &source)
+            .unwrap();
+    }
+    source.into()
+}
+#[cfg(test)]
+mod tests {
+    #[test]
+    fn control_is_original_shader() {
+        super::set(0);
+        assert_eq!(
+            super::shader(super::super::SPECTROGRAM_SRC.into()),
+            super::super::SPECTROGRAM_SRC
+        );
+    }
+}
