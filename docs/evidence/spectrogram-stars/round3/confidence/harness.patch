+            }
+            if let Some(video) = video.as_mut() {
+                video.stdin.as_mut().unwrap().write_all(&bytes).unwrap();
+            }
+            if n % 60 == 0 {
+                eprintln!("{name} {input} {n}/{count}");
+            }
+        }
+        if let Some(mut video) = video {
+            drop(video.stdin.take());
+            assert!(video.wait().unwrap().success());
+        }
+    }
+}
