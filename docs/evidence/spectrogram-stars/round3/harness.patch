+#[test]
+#[ignore]
+fn scratch_current_defaults_comparison() {
+    use std::io::Write;
+    let (device, queue) = headless_device().expect("GPU");
+    let root = std::env::var("PROBE_OUTPUT").unwrap();
+    let name = std::env::var("PROBE_NAME").unwrap();
+    let width: u32 = std::env::var("PROBE_WIDTH").ok().map(|x| x.parse().unwrap()).unwrap_or(1920);
+    let height = width * 9 / 16;
+    let frames: u32 = std::env::var("PROBE_FRAMES").ok().map(|x| x.parse().unwrap()).unwrap_or(360);
+    let inputs = std::env::var("PROBE_INPUTS").unwrap_or("take,flat".into());
+    let gradient = harmonigraph_scene::Gradient {
+        hue_start: 302.0,
+        hue_span: -181.224_01,
+        lightness: 50.0,
+        lightness_ramp: 100.0,
+        chroma: 0.794_999_96,
+        chroma_ramp: 0.410_000_03,
+        ..Default::default()
+    };
+    let pixels: Vec<[u8; 4]> = (0..4096)
+        .map(|i| {
+            let c = harmonigraph_scene::gradient_color((i as f32 + 0.5) / 4096.0, gradient);
+            let byte = |v: f32| (v.clamp(0.0, 1.0) * 255.0).round() as u8;
+            [byte(c.x), byte(c.y), byte(c.z), 255]
+        })
+        .collect();
+    for input in inputs.split(',') {
+        let full = std::fs::read(format!("{root}/{input}-levels.u8")).unwrap();
+        let mut cb = cloud_fixture();
+        cb.rect =
+            egui::Rect::from_min_size(egui::Pos2::ZERO, egui::vec2(width as f32, height as f32));
+        cb.grid = grid_of(Arc::new(full[..961 * 1024].to_vec()), 1024, 961, 0);
+        relay_quad(&mut cb, 960);
+        let lo = 69.0 + 12.0 * (70.0_f32 / 440.0).log2();
+        let span = 12.0 * (9000.0_f32 / 70.0).log2();
+        cb.read = read_of(lo, span, height);
+        cb.read.spectrum_min_midi = lo;
+        cb.read.bins_per_semitone = 1024.0 / span;
+        cb.read.level_per_midi = 0.0;
+        cb.read.level_per_step = 1.0 / 255.0;
+        cb.shades.lut = Arc::new(pixels.clone());
+        let a = cb.atmosphere.as_mut().unwrap();
+        a.region = cb.rect;
+        a.points_per_cent = height as f32 / (span * 100.0);
+        a.points_per_ms = width as f32 / 20000.0;
+        a.settings = SpectralAtmosphere { cloud_style: CloudStyle::Stars, ..Default::default() };
+        eprintln!("{name} {input}: {width}x{height}, settings {:?}", a.settings);
+        let mut resources = CallbackResources::default();
+        let count = if input == "flat" { 1 } else { frames };
+        let mut video = if count > 1 {
+            Some(
+                std::process::Command::new("ffmpeg")
+                    .args([
+                        "-v",
+                        "error",
+                        "-y",
+                        "-f",
+                        "rawvideo",
+                        "-pix_fmt",
+                        "rgba",
+                        "-s",
+                        &format!("{width}x{height}"),
+                        "-r",
+                        "60",
+                        "-i",
+                        "-",
+                        "-an",
+                        "-c:v",
+                        "libx264",
+                        "-preset",
+                        "fast",
+                        "-crf",
+                        "12",
+                        "-pix_fmt",
+                        "yuv420p",
+                        "-movflags",
+                        "+faststart",
+                        &format!("{root}/{name}-{width}.mp4"),
+                    ])
+                    .stdin(std::process::Stdio::piped())
+                    .spawn()
+                    .unwrap(),
+            )
+        } else {
+            None
+        };
+        for frame in 0..120 + count {
+            cb.pass_nr = frame as u64;
+            cb.atmosphere.as_mut().unwrap().now = 1.0 + f64::from(frame) / 60.0;
+            if input == "take" {
+                let col = (frame * 48 / 60) as usize;
+                cb.grid.set_bytes(&full[col * 1024..(col + 961) * 1024]);
+                relay_quad(&mut cb, 960);
+                let fraction = (frame * 48 % 60) as f32 / 60.0;
+                for vertex in &mut cb.vertices {
+                    vertex.slab += fraction;
+                }
+            }
+            if frame < 120 {
+                prepare_once(&device, &queue, &mut resources, &cb);
+                continue;
+            }
+            let bytes = frame_with(&device, &queue, &mut resources, &cb);
+            let n = frame - 120;
+            if n == 0 || n == 180 || n == 359 {
+                std::fs::write(format!("{root}/{name}-{input}-{width}-{n}.rgba"), &bytes).unwrap();
+            }
+            if let Some(video) = video.as_mut() {
+                video.stdin.as_mut().unwrap().write_all(&bytes).unwrap();
+            }
+            if n % 60 == 0 {
+                eprintln!("{name} {input} {n}/{count}");
+            }
+        }
+        if let Some(mut video) = video {
+            drop(video.stdin.take());
+            assert!(video.wait().unwrap().success());
+        }
+    }
+}
