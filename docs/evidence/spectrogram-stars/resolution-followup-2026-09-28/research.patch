@@ -4060,6 +4060,31 @@ fn cs_wrap_probe() {
     /// composite 16 to 21% without ever being taken, so the reference lives
     /// here instead.
     pub(super) fn pipeline_source() -> std::borrow::Cow<'static, str> {
+        if let Ok(scale) = std::env::var("RES_NEAR") {
+            let scale: f32 = scale.parse().unwrap();
+            let mut source = SPECTROGRAM_SRC.to_owned();
+            for entry in [
+                "fs_cloud_backdrop_gamma",
+                "fs_cloud_backdrop_linear",
+                "fs_cloud_gamma",
+                "fs_cloud_linear",
+            ] {
+                let old = format!("fn {entry}(in: VertexOut) -> @location(0) vec4<f32> {{");
+                let new = format!("fn {entry}(input: VertexOut) -> @location(0) vec4<f32> {{\n var in = input; in.position = vec4<f32>(input.position.xy / {scale:?}, input.position.zw);");
+                assert!(source.contains(&old));
+                source = source.replace(&old, &new);
+            }
+            source = source
+                .replace(
+                    "return vec4<f32>(linear_from_gamma_rgb(gamma.rgb), 1.0);",
+                    "return gamma;",
+                )
+                .replace(
+                    "return vec4<f32>(linear_from_gamma_rgb(color.rgb), color.a);",
+                    "return color;",
+                );
+            return source.into();
+        }
         if let Some(source) = star_split::reference_source() {
             return source.into();
         }
