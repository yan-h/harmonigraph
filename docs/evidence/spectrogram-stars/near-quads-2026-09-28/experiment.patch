+#[test]
+#[ignore = "bounded near-quad research image comparison"]
+fn near_quad_image_probe() {
+    let Some((device, queue)) = headless_device() else { panic!("GPU required") };
+    let output =
+        std::env::var("QUAD_OUTPUT").unwrap_or_else(|_| "/tmp/near-quads-images".to_owned());
+    std::fs::create_dir_all(&output).unwrap();
+    // size, scale, origin, jitter, density, memory, long-running clock.
+    let fixtures = [
+        ([768, 432], 1.0, egui::Pos2::ZERO, 0.5, 10.0, true, 0.0),
+        ([768, 432], 1.0, egui::Pos2::ZERO, 0.5, 0.5, false, 0.0),
+        ([321, 239], 1.25, egui::pos2(7.2, 11.6), 0.0, 10.0, true, 0.0),
+        ([321, 239], 1.25, egui::pos2(7.2, 11.6), 1.0, 0.5, true, 0.0),
+        ([960, 540], 4.0, egui::Pos2::ZERO, 1.0, 10.0, true, 1_000_000.0),
+    ];
+    for (fixture, (size, ppp, origin, jitter, density, memory, clock)) in
+        fixtures.into_iter().enumerate()
+    {
+        let mut cb = star_fixture(size, origin);
+        let bytes = std::fs::read("/private/tmp/stars-full-halo-compare/take-levels.u8").unwrap();
+        assert_eq!(bytes.len(), 960 * 1024);
+        let palette = std::fs::read("/private/tmp/stars-full-halo-compare/palette.rgba").unwrap();
+        cb.shades.lut =
+            Arc::new(palette.chunks_exact(4).map(|p| [p[0], p[1], p[2], p[3]]).collect());
+        cb.grid = grid_of(Arc::new(bytes.clone()), 1024, 968, 0);
+        relay_quad(&mut cb, 960);
+        for v in &mut cb.vertices {
+            v.pos[0] += origin.x;
+            v.pos[1] += origin.y;
+        }
+        let settings = &mut cb.atmosphere.as_mut().unwrap().settings;
+        *settings = harmonigraph_scene::SpectralAtmosphere::default();
+        settings.star_jitter = jitter;
+        settings.star_density = density;
+        if !memory {
+            settings.color_pickup = 0.0;
+            settings.color_release = 0.0;
+        }
+        let mut resources: [CallbackResources; 3] =
+            std::array::from_fn(|_| CallbackResources::default());
+        let mut sums = [0u64; 2];
+        let mut changed = [0u64; 2];
+        let mut max = [0u8; 2];
+        let mut count = 0u64;
+        let mut witness = [0u64; 2];
+        let mut prior: Option<Vec<u8>> = None;
+        let steps = if fixture == 4 {
+            5
+        } else if fixture < 2 {
+            192
+        } else {
+            36
+        };
+        let warmup = if fixture == 4 {
+            1
+        } else if fixture < 2 {
+            96
+        } else {
+            24
+        };
+        for step in 0..steps {
+            cb.pass_nr = step as u64;
+            cb.atmosphere.as_mut().unwrap().now = clock + 1.0 + step as f64 / 24.0;
+            // Scrolling recording-derived field. All modes see identical prefilled history.
+            let shift = step * 3 % 960;
+            let mut frame = bytes[shift * 1024..].to_vec();
+            frame.extend_from_slice(&bytes[..shift * 1024]);
+            cb.grid.set_bytes(&frame);
+            // Check release into silence in fractional cases, then recovery.
+            if fixture >= 2 && fixture < 4 && step >= 27 && step < 32 {
+                cb.grid.fill(0);
+            }
+            let pictures: [Vec<u8>; 3] = std::array::from_fn(|mode| {
+                QUAD_MODE.set(mode as u32);
+                frame_at_ppp(&device, &queue, &mut resources[mode], &cb, ppp)
+            });
+            if step < warmup {
+                continue;
+            }
+            let a = &pictures[0];
+            for mode in 1..3 {
+                for (i, (&x, &y)) in a.iter().zip(&pictures[mode]).enumerate() {
+                    if i % 4 == 3 {
+                        continue;
+                    }
+                    let delta = x.abs_diff(y);
+                    sums[mode - 1] += u64::from(delta);
+                    changed[mode - 1] += u64::from(delta > 0);
+                    max[mode - 1] = max[mode - 1].max(delta);
+                }
+            }
+            count += (a.len() / 4 * 3) as u64;
+            if let Some(previous) = prior.as_ref() {
+                witness[0] +=
+                    a.iter().zip(previous).filter(|(x, y)| x.abs_diff(**y) > 4).count() as u64;
+            }
+            prior = Some(a.clone());
+            let target = target(&resources[1]);
+            assert_eq!(
+                target.halo_layout().unwrap(),
+                atmosphere::star_halo_layout(
+                    [(size[0] as f32 * ppp) as u32, (size[1] as f32 * ppp) as u32],
+                    cb.atmosphere.unwrap().settings
+                )
+            );
+            if step == steps - 1 {
+                let dimensions = [
+                    (cb.rect.max.x * ppp).ceil() as u32 + 1,
+                    (cb.rect.max.y * ppp).ceil() as u32 + 1,
+                ];
+                for (mode, picture) in pictures.iter().enumerate() {
+                    std::fs::write(
+                        format!(
+                            "{output}/fixture-{fixture}-mode-{mode}-{}x{}.rgba",
+                            dimensions[0], dimensions[1]
+                        ),
+                        picture,
+                    )
+                    .unwrap();
+                }
+            }
+        }
+        eprintln!("QUAD_IMAGE fixture={fixture} size={size:?} ppp={ppp} jitter={jitter} density={density} memory={memory} rgb_count={count} motion_witness={}",witness[0]);
+        for mode in 1..3 {
+            eprintln!(
+                "QUAD_IMAGE mode={mode} max={} mean={:.9} changed={} total={count}",
+                max[mode - 1],
+                sums[mode - 1] as f64 / count as f64,
+                changed[mode - 1]
+            );
+        }
+        assert!(witness[0] > 100, "fixture did not move");
+        assert!(
+            max[0] <= 3 && sums[0] as f64 / count as f64 <= 0.05,
+            "residual quad parity failed"
+        );
+        if ppp == ppp.round() {
+            assert!(
+                max[1] <= 3 && sums[1] as f64 / count as f64 <= 0.05,
+                "native complete quad parity failed"
+            );
+        }
+    }
+    QUAD_MODE.set(0);
+}
