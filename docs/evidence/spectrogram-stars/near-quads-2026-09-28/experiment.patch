diff --git a/crates/harmonigraph-render/src/spectrogram/tests/near_quads.wgsl b/crates/harmonigraph-render/src/spectrogram/tests/near_quads.wgsl
new file mode 100644
index 00000000..a493810c
--- /dev/null
+++ b/crates/harmonigraph-render/src/spectrogram/tests/near_quads.wgsl
@@ -0,0 +1,66 @@
+
+struct NearQuad {
+    @builtin(position) position: vec4<f32>,
+    @location(0) @interpolate(flat) layer: u32,
+    @location(1) @interpolate(flat) cell: vec2<i32>,
+    @location(2) @interpolate(flat) packed: vec4<u32>,
+};
+@vertex
+fn vs_near_quad(@builtin(vertex_index) vertex: u32, @builtin(instance_index) instance: u32) -> NearQuad {
+    let k = instance >> 24u;
+    let local = i32(instance & 0xffffffu);
+    let s = cloud.star_slices[k];
+    let cell = s.origin + vec2<i32>(local % s.grid.x, local / s.grid.x);
+    let t = textureLoad(star_atlas, atlas_texel(s.base + local), 0);
+    var out: NearQuad;
+    out.layer = k;
+    out.cell = cell;
+    out.packed = t;
+    if t.w == 0u {
+        out.position = vec4<f32>(2.0, 2.0, 0.0, 1.0);
+        return out;
+    }
+    let center = vec2<f32>(bitcast<f32>(t.x), bitcast<f32>(t.y));
+    let relative = vec2<f32>(cell + vec2<i32>(floor(s.offset))) + fract(s.offset) + center;
+    let at = relative * s.cell * (cloud.size.y / STAR_PANE) + cloud.size * 0.5;
+    let extent = STAR_HALO_REACH * s.cell * cloud.size.y / STAR_PANE;
+    let margin = cloud.size / cloud.star_halo_samples[k].size / 16.0;
+    let corner = vec2<f32>(f32(vertex & 1u), f32(vertex >> 1u)) * 2.0 - 1.0;
+    let pt = at + corner * (vec2<f32>(extent) + margin);
+    out.position = vec4<f32>(pt / cloud.size * vec2<f32>(2.0, -2.0) + vec2<f32>(-1.0, 1.0), 0.0, 1.0);
+    return out;
+}
+@fragment
+fn fs_near_quad(in: NearQuad) -> @location(0) vec4<f32> {
+    let k = in.layer;
+    let s = cloud.star_slices[k];
+    let pt = in.position.xy * (cloud.size / cloud.star_halo_samples[k].size);
+    let sp = (pt - cloud.size * 0.5) * (STAR_PANE / cloud.size.y);
+    let r = sp / s.cell - fract(s.offset);
+    let o = floor(r);
+    let nominal = vec2<i32>(o) - vec2<i32>(floor(s.offset));
+    let neighbor = in.cell - nominal;
+    if any(abs(neighbor) > vec2<i32>(1)) { discard; }
+    // Same subtraction order as the gather, including long-running drift.
+    let f = r - o - vec2<f32>(neighbor);
+    let t = in.packed;
+    let dist = length(f - vec2<f32>(bitcast<f32>(t.x), bitcast<f32>(t.y))) * s.cell;
+    let outer = STAR_HALO_REACH * s.cell;
+    if dist >= outer { discard; }
+    let colour = vec3<f32>(vec3<u32>(t.z >> 20u, t.z >> 10u, t.z) & vec3<u32>(1023u)) / 1023.0;
+    let shape = unpack2x16float(t.w);
+    let d = dist * shape.x;
+    let gaussian = exp(-0.5 * d * d);
+    var full = gaussian;
+    if s.fringe > 0.0 { full += s.fringe * exp(-0.4 * d); }
+    full = min(full, 1.0) * (1.0 - smoothstep(STAR_HALO_FADE * outer, outer, dist));
+    var cover = full;
+    if !QUAD_COMPLETE {
+        let reach = cloud.star_geometry.y * s.cell;
+        let core = gaussian * (1.0 - smoothstep(cloud.star_geometry.z * reach, reach, dist));
+        cover = max(full - core, 0.0);
+    }
+    cover *= shape.y;
+    if cover <= 0.0 { discard; }
+    return vec4<f32>(colour * cover, cover);
+}
