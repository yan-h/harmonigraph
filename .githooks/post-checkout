#!/usr/bin/env bash
# Older worktrees still validate this shared hook and own their pin initializer.
# New checkouts have neither a pin nor an initializer.
set -euo pipefail

[ "${3:-}" = 1 ] || exit 0
case "${1:-}" in
  *[!0]* | '') exit 0 ;;
esac

ROOT=$(git rev-parse --show-toplevel)
if [ -x "$ROOT/.claude/ensure-shared-skills.sh" ]; then
  "$ROOT/.claude/ensure-shared-skills.sh" "$ROOT"
fi
